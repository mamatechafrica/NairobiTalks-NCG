# Environment Variables
# Copy this to .env and fill in your values

# Twilio Credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp Sandbox Number (default sandbox number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Server Configuration
PORT=3000
NODE_ENV=development

# Dashboard Admin Secret (for protected endpoints)
ADMIN_SECRET=your_admin_secret_here

# NairobiTalks Rails API Integration
# Set to 'true' to enable Rails API integration
USE_RAILS_API=false
RAILS_API_URL=http://localhost:3000/api/v1/whatsapp
RAILS_API_KEY=your_rails_api_key

# Privacy
PRIVACY_SALT=your_random_salt_here
