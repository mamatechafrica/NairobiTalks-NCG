<div class="d-flex align-items-center justify-content-center py-2">
  <div class="devise-form-wrapper w-100 mx-3">
    <h2 class="mb-4 text-center">Sign up</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mx-auto", style: "width:50%" }) do |f| %>
      <%= devise_error_messages! %>

      <div class="mb-3">
        <%= f.label :username %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="d-grid">
        <%= f.submit "Sign up", class: "btn btn-success py-3 px-2" %>
      </div>
    <% end %>

    <div class="mt-3 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>