<div class="flex items-center justify-center py-8">
  <div class="w-full max-w-md mx-3">
    <h2 class="mb-6 text-center text-3xl md:text-4xl font-extrabold">Sign in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mx-auto w-full" }) do |f| %>
      <%= devise_error_messages! %>

      <%= render 'admin/shared/form_field', label: 'Email' do %>
        <%= f.email_field :email, autofocus: true, class: 'input input-bordered w-full' %>
      <% end %>

      <%= render 'admin/shared/form_field', label: 'Password' do %>
        <%= f.password_field :password, autocomplete: 'current-password', class: 'input input-bordered w-full' %>
      <% end %>

      <div class="mb-4 flex items-center gap-2">
        <%= f.check_box :remember_me, class: 'checkbox' %>
        <%= f.label :remember_me, class: 'text-sm' %>
      </div>

      <div class="mb-3">
        <%= f.submit 'Sign in', class: 'w-full inline-flex items-center justify-center gap-2 text-white px-6 py-3 rounded text-lg focus:outline-none focus:ring-4', style: 'background-color: #18a147; box-shadow: 0 0 0 4px rgba(24, 161, 71, 0.4);' %>
      </div>
    <% end %>

    <div class="mt-4 text-center text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
