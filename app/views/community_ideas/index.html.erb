<div class="min-h-screen bg-base-100 flex flex-col items-center justify-center py-5">
  <%= render partial: 'shared/header', locals: { title: 'Explore Community Ideas' } %>

  <% sub_counties = {
    "Westlands" => ["Westlands","Kitisuru","Parklands/Highridge","Kangemi","Mountain View","Karura"],
    "Dagoretti North" => ["Kilimani","Kawangware","Gatina","Kileleshwa","Kabiro"],
    "Dagoretti South" => ["Mutuini","Ngando","Riruta","Uthiru/Ruthimitu","Waithaka"],
    "Langata" => ["Karen","Nairobi West","Mugumo-ini","South C","Nyayo Highrise"],
    "Kibra" => ["Laini Saba","Lindi","Makina","Woodley/Kenyatta Golf","Sarangombe"],
    "Roysambu" => ["Githurai","Kahawa West","Zimmerman","Roysambu","Kahawa"],
    "Kasarani" => ["Clay City","Mwiki","Kasarani","Njiru","Ruai"],
    "Ruaraka" => ["Baba Dogo","Utalii","Mathare North","Lucky Summer","Korogocho"],
    "Embakasi South" => ["Imara Daima","Kwa Njenga","Kwa Reuben","Pipeline","Kware"],
    "Embakasi North" => ["Kariobangi North","Dandora Area I","Dandora Area II","Dandora Area III","Dandora Area IV"],
    "Embakasi Central" => ["Kayole North","Kayole Central","Kayole South","Komarock","Matopeni"],
    "Embakasi East" => ["Upper Savanna","Lower Savanna","Embakasi","Utawala","Mihango"],
    "Embakasi West" => ["Umoja I","Umoja II","Mowlem","Kariobangi South"],
    "Makadara" => ["Maringo/Hamza","Viwandani","Harambee","Makongeni","South B"],
    "Kamukunji" => ["Pumwani","Eastleigh North","Eastleigh South","Airbase","California"],
    "Starehe" => ["Landimawe","Nairobi Central","Ngara","Pangani","Ziwani/Kariokor"],
    "Mathare" => ["Hospital","Mabatini","Huruma","Ngei","Mlango Kubwa"]
  } %>

  <div class="w-full max-w-4xl mx-auto mb-4 px-4">
    <%= form_with url: community_ideas_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-3 p-4 rounded-lg shadow-md", style: 'background: #fff; border: 2px solid #004225;' do |f| %>
      <div class="lg:col-span-1 md:col-span-1 col-span-1">
        <%= f.label :search, "Search", class: "block font-bold text-sm", style: 'color: #004225;' %>
        <%= f.text_field :search, value: params[:search], class: "input input-bordered w-full text-sm", placeholder: "Search...", style: 'background: #f8fff8; color: #004225; font-weight: bold; border-width: 2px;' %>
      </div>
      <div class="lg:col-span-1 md:col-span-1 col-span-1">
        <%= f.label :sub_county, "Sub-county", class: "block font-bold text-sm", style: 'color: #004225;' %>
        <%= f.select :sub_county, options_for_select(["All"] + sub_counties.keys, params[:sub_county]), {}, class: "select select-bordered w-full text-sm", style: 'background: #f8fff8; color: #004225; font-weight: bold; border-width: 2px;' %>
      </div>
      <div class="lg:col-span-1 md:col-span-1 col-span-1">
        <%= f.label :ward, "Ward", class: "block font-bold text-sm", style: 'color: #004225;' %>
        <% ward_list = if params[:sub_county].present? && params[:sub_county] != 'All'
          (sub_counties[params[:sub_county]] || [])
        else
          CommunityIdea.where.not(ward: [nil, ""]).distinct.pluck(:ward)
        end %>
        <%= f.select :ward, options_for_select(["All"] + ward_list, params[:ward]), {}, class: "select select-bordered w-full text-sm", style: 'background: #f8fff8; color: #004225; font-weight: bold; border-width: 2px;' %>
      </div>
      <div class="lg:col-span-1 md:col-span-1 col-span-1">
        <%= f.label :topic, "Topic", class: "block font-bold text-sm", style: 'color: #004225;' %>
        <%= f.select :topic, options_for_select(["All"] + CommunityIdea.where.not(topic: [nil, ""]).distinct.pluck(:topic), params[:topic]), {}, class: "select select-bordered w-full text-sm", style: 'background: #f8fff8; color: #004225; font-weight: bold; border-width: 2px;' %>
      </div>
      <div class="lg:col-span-1 md:col-span-1 col-span-1">
        <%= f.label :status, "Status", class: "block font-bold text-sm", style: 'color: #004225;' %>
        <%= f.select :status, options_for_select(["All"] + CommunityIdea::STATUSES.keys.map(&:to_s), params[:status]), {}, class: "select select-bordered w-full text-sm", style: 'background: #f8fff8; color: #004225; font-weight: bold; border-width: 2px;' %>
      </div>
      <div class="lg:col-span-1 md:col-span-2 col-span-1 flex items-end">
        <%= f.submit "Search", class: "btn w-full font-bold", style: 'background: #004225; color: #fff; border-width: 2px; border-color: #004225;' %>
      </div>
    <% end %>
  </div>

  <div class="w-full max-w-6xl mx-auto py-4 px-4">
    <% if @community_ideas.present? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @community_ideas.each do |idea| %>
          <div>
            <%= render partial: "community_ideas/idea_card", locals: { idea: idea } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center justify-center text-gray-500 text-center px-4 py-12">
        <p class="text-lg">No ideas yet. Be the first to submit one!</p>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if defined?(@total_pages) && @total_pages && @total_pages > 1 %>
    <div class="w-full max-w-6xl mx-auto mb-4 px-4">
      <div class="flex justify-center">
        <nav aria-label="Community ideas pagination" class="join">
          <% if @current_page && @current_page > 1 %>
            <%= link_to "« Prev", url_for(params.permit!.to_h.merge(page: @current_page - 1)), class: "join-item btn" %>
          <% else %>
            <button class="join-item btn btn-disabled">« Prev</button>
          <% end %>

          <% (1..@total_pages).each do |p| %>
            <% if p == @current_page %>
              <button class="join-item btn btn-active"><%= p %></button>
            <% else %>
              <%= link_to p, url_for(params.permit!.to_h.merge(page: p)), class: "join-item btn" %>
            <% end %>
          <% end %>

          <% if @current_page && @total_pages && @current_page < @total_pages %>
            <%= link_to "Next »", url_for(params.permit!.to_h.merge(page: @current_page + 1)), class: "join-item btn" %>
          <% else %>
            <button class="join-item btn btn-disabled">Next »</button>
          <% end %>
        </nav>
      </div>
    </div>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const subSelect = document.querySelector('select[name="sub_county"]');
  const wardSelect = document.querySelector('select[name="ward"]');
  if (!subSelect || !wardSelect) return;

  const subCounties = <%= raw(sub_counties.to_json) %>;

  subSelect.addEventListener('change', (e) => {
    const selected = e.target.value;
    const wards = (selected !== 'All' && subCounties[selected])
      ? subCounties[selected]
      : [];

    wardSelect.innerHTML = '<option value="All">All</option>';

    wards.forEach(w => {
      const opt = new Option(w, w);
      wardSelect.appendChild(opt);
    });
  });

  // Optional: apply current value on page load
  subSelect.dispatchEvent(new Event('change'));
});
</script>
