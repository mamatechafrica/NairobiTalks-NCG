<div class="bg-[var(--color-background)] min-h-screen flex flex-col items-center justify-center py-12">
  <%= render partial: 'shared/header', locals: { title: 'Explore Community Ideas' } %>
  <div class="max-w-6xl mx-auto px-6 mb-6">
    <%= form_with url: community_ideas_path, method: :get, local: true, class: "w-full bg-white rounded-lg p-4 shadow-sm border-2 border-[var(--color-primary)] flex flex-wrap gap-4 items-end", style: 'flex-wrap: wrap;' do |f| %>
      <div class="w-full md:w-1/4 lg:w-1/5">
        <%= f.label :search, "Search", class: "block font-semibold", style: 'color: #004225;' %>
        <%= f.text_field :search, value: params[:search], class: "block w-full border-2 border-[var(--color-primary)] bg-[#f8fff8] text-[var(--color-primary)] font-semibold px-3 py-2 rounded", placeholder: "Search ideas...", style: '' %>
      </div>
      <div class="w-full md:w-1/6 lg:w-1/6">
        <%= f.label :ward, "Ward", class: "block font-semibold", style: 'color: #004225;' %>
        <%= f.select :ward, options_for_select(["All"] + CommunityIdea.where.not(ward: [nil, ""]).distinct.pluck(:ward), params[:ward]), {}, class: "block w-full border-2 border-[var(--color-primary)] bg-[#f8fff8] text-[var(--color-primary)] font-semibold px-3 py-2 rounded", style: '' %>
      </div>
      <div class="w-full md:w-1/6 lg:w-1/6">
        <%= f.label :topic, "Topic", class: "block font-semibold", style: 'color: #004225;' %>
        <%= f.select :topic, options_for_select(["All"] + CommunityIdea.where.not(topic: [nil, ""]).distinct.pluck(:topic), params[:topic]), {}, class: "block w-full border-2 border-[var(--color-primary)] bg-[#f8fff8] text-[var(--color-primary)] font-semibold px-3 py-2 rounded", style: '' %>
      </div>
      <div class="w-full md:w-1/6 lg:w-1/6">
        <%= f.label :status, "Status", class: "block font-semibold", style: 'color: #004225;' %>
        <%= f.select :status, options_for_select(["All"] + CommunityIdea::STATUSES.keys.map(&:to_s), params[:status]), {}, class: "block w-full border-2 border-[var(--color-primary)] bg-[#f8fff8] text-[var(--color-primary)] font-semibold px-3 py-2 rounded", style: '' %>
      </div>
      <div class="w-full md:w-1/6 lg:w-1/6">
        <%= f.submit "Search", class: "bg-[var(--color-primary)] text-white font-bold w-full py-3 rounded" %>
      </div>
    <% end %>
  </div>
  <% if user_signed_in? %>
    <div class="max-w-6xl mx-auto px-6 py-6">
      <% if @community_ideas.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @community_ideas.each do |idea| %>
            <div>
              <%= render partial: "community_ideas/idea_card", locals: { idea: idea } %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="h-40 flex items-center justify-center text-muted text-center px-4">
          <p class="text-lg">No ideas yet. Be the first to submit one!</p>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="max-w-6xl mx-auto px-6 py-6">
      <% if @community_ideas.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @community_ideas.each do |idea| %>
            <div>
              <%= render partial: "community_ideas/idea_card", locals: { idea: idea } %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="h-40 flex items-center justify-center text-muted text-center px-4">
          <p class="text-lg">No ideas yet. Be the first to submit one!</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
