<div class="bg-base-100 min-h-screen">
  <%= render partial: 'shared/header', locals: { title: 'Idea Details', back_path: community_ideas_path } %>
  <main class="max-w-3xl mx-auto py-8 px-4">
    <div class="mb-6">
      <%= render partial: "community_ideas/idea_card", locals: { idea: @community_idea, large: true } %>
    </div>

    <section>
      <%= render partial: "community_ideas/comment_form", locals: { community_idea: @community_idea, comment: Comment.new } %>

      <% if @community_idea.comments.any? %>
        <div class="space-y-4 mt-6">
          <% @community_idea.comments.order(created_at: :desc).each do |comment| %>
            <div class="bg-white rounded-lg shadow-sm p-4">
              <div class="flex items-start gap-4">
                <% if comment.user && comment.user.respond_to?(:avatar_url) && comment.user.avatar_url.present? %>
                  <img src="<%= comment.user.avatar_url %>" alt="avatar" class="rounded-full" style="width: 48px; height: 48px; object-fit: cover;">
                <% else %>
                  <div class="rounded-full bg-success text-white flex items-center justify-center" style="width: 48px; height: 48px; font-size: 1.25rem;">
                    <%= comment.user&.email&.first&.upcase || 'U' %>
                  </div>
                <% end %>

                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="font-semibold text-base">@<%= comment.user&.username || comment.user&.email&.split('@')&.first || 'anonymous' %></div>
                      <div class="text-sm text-muted"><%= time_ago_in_words(comment.created_at) %> ago</div>
                    </div>
                  </div>

                  <div class="mt-3 text-gray-800" style="font-size: 1.05rem;"><%= comment.body&.html_safe %></div>

                  <% if comment.user == current_user %>
                    <div class="flex justify-end gap-2 mt-3">
                      <%= button_to 'Delete', community_idea_comment_path(@community_idea, comment), method: :delete, data: { confirm: 'Are you sure you want to delete this comment?' }, class: 'btn btn-error px-3 py-2', style: 'font-weight: 600; font-size: 1rem; border-radius: 0.5rem; display: inline-block;', form: { style: 'display: inline;' }, aria: { label: 'Delete comment' } %>
                      <button type="button" class="btn px-3 py-2" style="font-weight: 600; font-size: 1rem; border-radius: 0.5rem; background: #fff; color: #222; border: 2px solid #198754;" aria-label="Edit comment" data-bs-toggle="modal" data-bs-target="#editCommentModal-<%= comment.id %>">Edit</button>

                      <div class="modal fade" id="editCommentModal-<%= comment.id %>" tabindex="-1" aria-labelledby="editCommentModalLabel-<%= comment.id %>" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title" id="editCommentModalLabel-<%= comment.id %>">Edit Comment</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                              <%= form_with(model: [@community_idea, comment], local: true) do |f| %>
                                <div class="mb-0">
                                  <%= f.text_area :body, class: "form-control border-0 shadow-none w-full", rows: 2, placeholder: "Edit your comment...", style: "background: transparent; resize: none; font-size: 1.1rem;" %>
                                </div>
                                <div class="flex justify-end mt-2">
                                  <%= f.submit "Update", class: "btn btn-success px-4" %>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-4">
          <p class="text-muted mb-0">No comments yet. Be the first to comment!</p>
        </div>
      <% end %>
    </section>
  </main>
</div>