<div class="bg-light min-vh-100">
  <%= render partial: 'shared/header', locals: { title: 'Idea Details', back_path: community_ideas_path } %>
  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="mb-5" style="max-width: 100%;">
          <%= render partial: "community_ideas/idea_card", locals: { idea: @community_idea, large: true } %>
        </div>
        <section>
          <!-- Floating Comment Input -->
          <%= render partial: "community_ideas/comment_form", locals: { community_idea: @community_idea, comment: Comment.new } %>
          <!-- Comments List -->
          <% if @community_idea.comments.any? %>
            <% @community_idea.comments.order(created_at: :desc).each do |comment| %>
              <div class="card mb-4 shadow-sm border-0" style="border-radius: 1rem;">
                <div class="card-body pb-3 pt-4 px-4">
                  <div class="d-flex align-items-center mb-2">
                    <% if comment.user && comment.user.respond_to?(:avatar_url) && comment.user.avatar_url.present? %>
                      <img src="<%= comment.user.avatar_url %>" alt="avatar" class="rounded-circle me-3" style="width: 48px; height: 48px; object-fit: cover;">
                    <% else %>
                      <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <%= comment.user&.email&.first&.upcase || 'U' %>
                      </div>
                    <% end %>
                    <div>
                      <div class="fw-bold" style="font-size: 1.1rem;">
                        @<%= comment.user&.username || comment.user&.email&.split('@')&.first || 'anonymous' %>
                      </div>
                      <div class="text-muted small">
                        <%= time_ago_in_words(comment.created_at) %> ago
                      </div>
                    </div>
                    <!-- No like button/icon -->
                  </div>
                  <div class="mt-2 mb-0" style="font-size: 1.08rem; color: #222;">
                    <%= comment.body&.html_safe %>
                  </div>
                  <% if comment.user == current_user %>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                      <%= button_to 'Delete', community_idea_comment_path(@community_idea, comment), method: :delete, data: { confirm: 'Are you sure you want to delete this comment?' }, class: 'btn btn-danger px-3 py-2', style: 'font-weight: 600; font-size: 1rem; border-radius: 0.5rem; display: inline-block;', form: { style: 'display: inline;' }, aria: { label: 'Delete comment' } %>
                      <button type="button" class="btn edit-btn px-3 py-2" style="font-weight: 600; font-size: 1rem; border-radius: 0.5rem; background: #fff; color: #222; border: 2px solid #198754;" aria-label="Edit comment" data-bs-toggle="modal" data-bs-target="#editCommentModal-<%= comment.id %>">Edit</button>
                      <!-- Edit Comment Modal -->
                      <div class="modal fade" id="editCommentModal-<%= comment.id %>" tabindex="-1" aria-labelledby="editCommentModalLabel-<%= comment.id %>" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title" id="editCommentModalLabel-<%= comment.id %>">Edit Comment</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                              <%= form_with(model: [@community_idea, comment], local: true) do |f| %>
                                <div class="mb-0">
                                  <%= f.text_area :body, class: "form-control border-0 shadow-none", rows: 2, placeholder: "Edit your comment...", style: "background: transparent; resize: none; font-size: 1.1rem;" %>
                                </div>
                                <div class="d-flex justify-content-end mt-2">
                                  <%= f.submit "Update", class: "btn btn-success px-4" %>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <p class="text-muted mb-0">No comments yet. Be the first to comment!</p>
            </div>
          <% end %>
        </section>
      </div>
    </div>
  </main>
</div>