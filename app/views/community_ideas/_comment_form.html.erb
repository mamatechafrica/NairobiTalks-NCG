<div class="mb-4 bg-[#eafaf3] rounded-lg shadow p-6 pb-4">
  <% if user_signed_in? %>
    <%= form_with(model: [community_idea, comment], local: true) do |f| %>
      <div class="mb-0">
        <%= f.text_area :body, class: "block w-full bg-transparent rounded-none border-0 px-0 py-1 text-base resize-none", rows: 2, placeholder: "Leave a constructive comment...", style: "background: transparent; resize: none; font-size: 1.1rem;" %>
      </div>
      <div class="flex justify-end gap-2 mt-2">
        <%= f.submit(comment.persisted? ? "Update" : "Post", class: "inline-block px-3 py-2 rounded bg-[var(--color-success)] text-white font-semibold", style: "font-size: 0.95rem; display: inline-block; width: auto;", aria: { label: (comment.persisted? ? 'Update comment' : 'Post comment') }) %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-3">
      <p class="mb-2">Want to comment? <%= link_to 'Sign in', new_user_session_path %> or <%= link_to 'Sign up', new_user_registration_path %> to participate.</p>
    </div>
  <% end %>
</div>
