<div class="bg-white h-100 shadow-sm border-[var(--color-primary)] <%= local_assigns[:large] ? 'p-6 max-w-[700px] mx-auto' : 'p-4' %> rounded-lg">
  <%# Image section %>
  <% img_height = local_assigns[:large] ? '340px' : '200px' %>
  <% if idea.respond_to?(:image_url) && idea.image_url.present? %>
    <img src="<%= idea.image_url %>" alt="Idea image" class="w-full object-cover <%= local_assigns[:large] ? 'h-[340px]' : 'h-[200px]' %>">
  <% else %>
    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=700&q=80" alt="Placeholder image" class="w-full object-cover <%= local_assigns[:large] ? 'h-[340px]' : 'h-[200px]' %>">
  <% end %>
  <div class="p-4 flex flex-col">
    <h3 class="font-bold text-[var(--color-primary)] mb-2 <%= 'text-2xl' if local_assigns[:large] %>"><%= idea.title %></h3>
    <div class="mb-2">
      <% if idea.ward.present? %>
        <span class="inline-block bg-gray-200 text-gray-700 px-2 py-1 rounded mr-2"><%= idea.ward %></span>
      <% end %>
      <% if idea.topic.present? %>
        <span class="inline-block bg-[var(--color-primary)] text-white px-2 py-1 rounded"><%= idea.topic %></span>
      <% end %>
    </div>
    <p class="text-muted mb-3 min-h-[3em] <%= local_assigns[:large] ? 'text-[1.15rem]' : 'text-base' %>"><%= local_assigns[:large] ? idea.description : truncate(idea.description, length: 100) %></p>
    <div class="flex items-center justify-between mt-auto">
      <span class="text-muted text-sm">👍 <%= idea.upvotes %> | 👎 <%= idea.downvotes %></span>
      <% if local_assigns[:large] %>
        <div class="flex justify-center gap-5">
          <% if user_signed_in? %>
            <%= button_to upvote_community_idea_path(idea), method: :post, class: 'border-2 border-[var(--color-primary)] rounded-full w-16 h-16 text-2xl flex items-center justify-center', style: '', form: { data: { turbo: "false" } }, title: 'Vote Yes' do %>
              <span aria-hidden="true">✔</span>
              <span class="sr-only">Yes</span>
            <% end %>
            <%= button_to downvote_community_idea_path(idea), method: :post, class: 'border-2 border-red-500 rounded-full w-16 h-16 text-2xl flex items-center justify-center', style: '', form: { data: { turbo: "false" } }, title: 'Vote No' do %>
              <span aria-hidden="true">✖</span>
              <span class="sr-only">No</span>
            <% end %>
          <% else %>
            <div class="text-center">
              <%= link_to 'Sign in to vote', new_user_session_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-[var(--color-primary)] text-white font-semibold', aria: { label: 'Sign in to vote' } %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= link_to "Details", community_idea_path(idea), class: "inline-block px-3 py-1 text-[var(--color-primary)] border border-[var(--color-primary)] rounded-sm text-sm" %>
      <% end %>
    </div>
  </div>
</div>