<div class="flex flex-col items-center justify-center" style="max-width: 40rem; margin: 0 auto;">
  <% voted_ids = session[:voted_idea_ids] || [] %>
  <% unvoted_ideas = ideas.reject { |idea| voted_ids.include?(idea.id) } %>
  <% if unvoted_ideas.any? %>
    <div id="ideas-carousel" data-component="carousel" class="w-full">
      <% unvoted_ideas.each_with_index do |idea, idx| %>
        <div class="idea-slide <%= 'hidden' unless idx == 0 %>" data-slide-index="<%= idx %>" style="max-width: 28rem; margin: 0 auto;">
          <div class="card bg-base-100 shadow-lg rounded-lg border border-success w-full">
            <div class="card-body p-4 flex flex-col justify-between h-full">
              <div>
                <h2 class="text-xl font-bold mb-3"><%= idea.title %></h2>
                <% if idea.ward.present? %>
                  <p class="text-sm text-gray-500 mb-2">Ward: <%= idea.ward %></p>
                <% end %>
                <% if idea.topic.present? %>
                  <span class="badge badge-primary text-white text-sm px-3 py-1 mb-3">
                    <%= idea.topic %>
                  </span>
                <% end %>
                <p class="text-gray-800" style="line-height: 1.5;"><%= idea.description %></p>
              </div>
              <div class="mt-4 flex justify-center gap-4 text-sm text-gray-500">
                <span>👍 <%= idea.upvotes %></span>
                <span>👎 <%= idea.downvotes %></span>
              </div>
              <%= link_to "View Details & Comment",
                          community_idea_path(idea),
                          class: "mt-4 btn btn-primary w-full font-medium",
                          data: { turbo_frame: "_top" } %>
              <div class="mt-4 flex justify-center gap-5">
                <form action="<%= upvote_community_idea_path(idea) %>" method="post" data-turbo="false">
                  <input type="hidden" name="_method" value="post">
                  <button type="submit" class="btn btn-success btn-lg rounded-full flex items-center justify-center text-white" style="width: 4rem; height: 4rem;" title="Vote Yes" aria-label="Vote Yes">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                </form>
                <form action="<%= downvote_community_idea_path(idea) %>" method="post" data-turbo="false">
                  <input type="hidden" name="_method" value="post">
                  <button type="submit" class="btn btn-error btn-lg rounded-full flex items-center justify-center text-white" style="width: 4rem; height: 4rem;" title="Vote No" aria-label="Vote No">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                      <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <!-- Navigation buttons -->
    <div class="flex justify-center gap-6 mt-8">
      <button id="slide-prev" type="button" aria-label="Previous idea" class="btn btn-circle btn-outline btn-lg" onclick="slideCarousel(-1)">❮</button>
      <button id="slide-next" type="button" aria-label="Next idea" class="btn btn-circle btn-outline btn-lg" onclick="slideCarousel(1)">❯</button>
    </div>
    <script>
      let currentSlide = 0;
      const slides = document.querySelectorAll('.idea-slide');
      const totalSlides = slides.length;
      function showSlide(n) {
        slides.forEach(s => s.classList.add('hidden'));
        if (n >= totalSlides) currentSlide = 0;
        if (n < 0) currentSlide = totalSlides - 1;
        slides[currentSlide]?.classList.remove('hidden');
      }
      function slideCarousel(direction) {
        currentSlide += direction;
        showSlide(currentSlide);
      }
    </script>
  <% else %>
    <div class="py-12 text-center text-gray-500">
      <p class="text-lg font-semibold">No more ideas to vote on. Thank you!</p>
    </div>
  <% end %>
</div>
