<header class="bg-white shadow-sm py-4 rounded border border-[var(--color-success)] mb-4">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center">
      <div class="flex-1">
        <% if defined?(back_path) && back_path.present? %>
          <a href="<%= back_path %>" class="text-[var(--color-success)] font-medium hover:underline">← Back</a>
        <% end %>
      </div>
      <div class="flex-1 text-center">
        <h1 class="font-bold text-[var(--color-success)] mb-0"><%= title %></h1>
      </div>
      <div class="flex-1"></div>
    </div>
  </div>
</header>
