<header class="bg-white shadow-sm py-4 rounded border border-success mb-4">
  <div class="container">
    <div class="row align-items-center">
      <% if defined?(back_path) && back_path.present? %>
        <div class="col">
          <a href="<%= back_path %>" class="text-success fw-medium text-decoration-none">
            ← Back
          </a>
        </div>
      <% else %>
        <div class="col"></div>
      <% end %>
      <div class="col text-center">
        <h1 class="fw-bold text-success mb-0">
          <%= title %>
        </h1>
      </div>
      <div class="col"></div>
    </div>
  </div>
</header>
