<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for(:title) || "Nairobi Talks" %></title>
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">

  <!-- Bootstrap 5.3 + icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Trix -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</head>

<body class="d-flex flex-column min-vh-100 bg-white">

  <!-- Skip link -->
  <a href="#main-content" class="visually-hidden-focusable position-absolute start-0 mt-2 ms-2 z-3">Skip to main content</a>

  <!-- Navbar ─────────────────────────────────────────────── -->
  <nav class="navbar navbar-expand-lg bg-dark-green text-white" style="--bs-navbar-padding-y: 0.6rem; border-radius: 0.375rem; background-color: #004225 !important; color: #fff !important;">
    <div class="container-xl px-3 px-sm-4">

      <!-- Brand -->
      <%= link_to root_path, class: "navbar-brand d-flex align-items-center py-2 me-3" do %>
        <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks', style: 'height:120px; width:auto; border-radius: 0.375rem; object-fit:contain;' %>
      <% end %>

      <!-- Toggler -->
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation" style="border:1px solid rgba(255,255,255,0.18); background: transparent; color: #fff; padding: .2rem .5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="22" viewBox="0 0 30 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M3 6h24" />
          <path d="M3 12h24" />
          <path d="M3 18h24" />
        </svg>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <!-- Primary nav -->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
          <li class="nav-item">
            <%= link_to "Community Ideas", community_ideas_path, class: "btn btn-light text-dark-green fw-semibold px-3 py-2" %>
          </li>
        </ul>

        <!-- Right side: primary CTA then auth -->
        <div class="d-flex align-items-center gap-2">
          <!-- Main CTA: Submit Idea (prominent and trust-focused) -->
          <% if user_signed_in? %>
            <%= link_to "Submit Idea", new_submission_path, class: "btn btn-light text-dark-green fw-semibold px-3 py-2", aria: { label: "Submit a new idea" } %>
          <% else %>
            <%= link_to "Submit Idea", new_submission_path, class: "btn btn-light text-dark-green fw-semibold px-3 py-2", aria: { label: "Submit a new idea (sign in required)" } %>
          <% end %>

          <% if user_signed_in? %>
            <div class="dropdown">
              <a class="d-flex align-items-center text-decoration-none text-white gap-2 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="rounded-circle bg-white text-dark-green d-flex align-items-center justify-content-center fw-bold" style="width:36px; height:36px; font-size:1rem;">
                  <%= current_user.email.first.upcase %>
                </div>
                <span class="d-none d-lg-inline fw-medium"><%= current_user.email.truncate(22) %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                <li><%= link_to "Profile", profile_path, class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider"></li>
                <li><%= link_to "Sign out", destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" %></li>
              </ul>
            </div>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-light text-dark-green fw-semibold px-3 py-2" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main content ─────────────────────────────────────────────── -->
  <main id="main-content" class="flex-grow-1 py-5" tabindex="-1">
    <div class="container-xl px-3 px-sm-4">
      <%= yield %>
    </div>
  </main>

  <!-- Footer ─────────────────────────────────────────────── -->
  <footer class="bg-dark-green text-white py-5 mt-auto w-100" style="background-color: #004225 !important; border-radius: 0.375rem; color: #fff !important;">
    <div class="container-xl px-3 px-sm-4" style="background: transparent;">
      <div class="row g-5">
        <div class="col-lg-5">
          <div class="d-flex align-items-center mb-3">
            <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks', style: 'height: 80px; width: auto; border-radius: 0.375rem; object-fit: contain;' %>
          </div>
          <p class="text-white-75 mb-0" style="max-width: 420px;">
            Empowering Nairobi citizens to propose, discuss and vote on community ideas — anonymously and democratically.
          </p>
        </div>

        <div class="col-6 col-lg-2">
          <h6 class="text-uppercase fw-semibold mb-3">Explore</h6>
          <ul class="list-unstyled small lh-lg">
            <li><%= link_to "All Ideas", community_ideas_path, class: "text-white text-opacity-75 text-decoration-none hover-opacity-100" %></li>
            <% if user_signed_in? %>
              <li><%= link_to "Submit Idea", new_submission_path, class: "text-white text-opacity-75 text-decoration-none hover-opacity-100" %></li>
            <% end %>
          </ul>
        </div>

        <div class="col-6 col-lg-2">
          <h6 class="text-uppercase fw-semibold mb-3">Account</h6>
          <ul class="list-unstyled small lh-lg">
            <% if user_signed_in? %>
              <li><%= link_to "Profile", profile_path, class: "text-white text-opacity-75 text-decoration-none hover-opacity-100" %></li>
              <li><%= link_to "Sign out", destroy_user_session_path, method: :delete, class: "text-white text-opacity-75 text-decoration-none hover-opacity-100" %></li>
            <% else %>

              <li><%= link_to "Sign up", new_user_registration_path, class: "text-white text-opacity-75 text-decoration-none hover-opacity-100" %></li>
            <% end %>
          </ul>
        </div>
      </div>

      <hr class="my-4 opacity-25">

      <div class="text-center small text-white-50">
        <p class="mb-1">© <%= Time.current.year %> Nairobi Talks</p>
        <p class="mb-0">Made by citizens • For citizens</p>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>