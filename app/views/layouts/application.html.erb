<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Nairobi Talks" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nairobi Talks">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <%= javascript_importmap_tags %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  </head>
  <body class="bg-[var(--color-background)]">
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to main content</a>

    <nav class="fixed top-0 left-0 right-0 shadow-sm bg-[var(--color-primary)]" role="navigation" aria-label="Main navigation">
      <div class="max-w-6xl mx-auto px-6">
          <div class="flex items-center justify-between h-20 md:h-24">
          <div class="flex items-center gap-4">
            <%= link_to root_path, class: "flex items-center" do %>
              <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks Logo', class: 'block w-20 h-20 md:w-24 md:h-24 object-contain filter brightness-110 contrast-125' %>
            <% end %>
          </div>

          <div class="hidden md:flex items-center gap-6">
            <%= link_to "Community Ideas", community_ideas_path, class: "text-white font-semibold hover:underline" %>
            <% if user_signed_in? %>
              <%= link_to "Submit Ideas", new_submission_path, class: "inline-block px-4 py-2 rounded bg-[var(--color-secondary)] text-white" %>
            <% end %>
            <% if user_signed_in? && current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "text-red-400 font-semibold" %>
            <% end %>
          </div>

          <div class="flex items-center gap-3">
            <% if user_signed_in? %>
              <details class="relative">
                <summary class="flex items-center gap-3 cursor-pointer list-none">
                  <div class="rounded-full bg-[var(--color-primary-foreground)] text-[var(--color-primary)] w-10 h-10 flex items-center justify-center"><%= current_user.email.first.upcase %></div>
                  <span class="hidden md:inline font-medium text-white"><%= current_user.email %></span>
                </summary>
                <div class="absolute right-0 mt-2 w-48 bg-white rounded shadow z-20">
                  <%= link_to "My Profile", profile_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                  <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-red-600 hover:bg-gray-100" %>
                </div>
              </details>
            <% else %>
              <%= link_to "Sign In", new_user_session_path, class: "text-white font-semibold" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "ml-2 inline-block px-4 py-2 rounded bg-white text-[var(--color-primary)] font-bold" %>
            <% end %>

            <!-- Mobile menu -->
            <details class="md:hidden relative">
              <summary class="px-3 py-2 rounded text-white">Menu</summary>
              <div class="absolute right-0 mt-2 w-48 bg-white rounded shadow z-20">
                <%= link_to "Community Ideas", community_ideas_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                <% if user_signed_in? %>
                  <%= link_to "Submit Ideas", new_submission_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                <% end %>
                <% if user_signed_in? && current_user.admin? %>
                  <%= link_to "Admin", admin_root_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                <% end %>
                <% if user_signed_in? %>
                  <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-red-600 hover:bg-gray-100" %>
                <% else %>
                  <%= link_to "Sign In", new_user_session_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                  <%= link_to "Sign Up", new_user_registration_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                <% end %>
              </div>
            </details>
          </div>
        </div>
      </div>
    </nav>
    <div class="h-20 md:h-24"></div>

    <% if flash.any? %>
      <div class="max-w-6xl mx-auto px-6 mt-4">
        <% flash.each do |name, msg| %>
          <div class="mb-2 rounded px-4 py-3 <%= name == 'notice' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
            <%= msg %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main id="main-content" class="max-w-6xl mx-auto px-6 mt-6 pt-4" tabindex="-1">
      <%= yield %>
    </main>

    <footer class="mt-12 bg-[var(--color-primary)] text-white py-12">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <div class="mb-3">
              <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks Logo', class: 'block w-20 h-20 md:w-24 md:h-24 object-contain' %>
            </div>
            <p class="text-sm text-white/90">
              Empowering citizens to shape their community through anonymous idea submission and democratic voting.
            </p>
          </div>
          <div>
            <h5 class="font-semibold mb-3">Quick Links</h5>
            <ul class="space-y-2">
              <li><%= link_to "Discover Ideas", community_ideas_path, class: "text-white hover:underline" %></li>
              <li><%= link_to "Submit Idea", new_submission_path, class: "text-white hover:underline" %></li>
              <% if user_signed_in? %>
                <li><%= link_to "Your Profile", edit_user_registration_path, class: "text-white hover:underline" %></li>
              <% end %>
            </ul>
          </div>
          <div>
            <h5 class="font-semibold mb-3">Community</h5>
            <div class="flex gap-3">
              <a class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white text-[var(--color-primary)]" href="#" aria-label="Twitter">T</a>
              <a class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white text-[var(--color-primary)]" href="#" aria-label="Facebook">F</a>
              <a class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white text-[var(--color-primary)]" href="#" aria-label="Instagram">I</a>
            </div>
          </div>
        </div>

        <div class="mt-8 text-center text-white/80">
          <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks Logo', class: 'mx-auto w-20 h-20 md:w-24 md:h-24 object-contain filter brightness-110 contrast-125' %>
          <p class="mt-2">&copy; 2025. Powered by citizens like you.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
