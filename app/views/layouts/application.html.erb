<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Nairobi Talks" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nairobi Talks">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <%= javascript_importmap_tags %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Bootstrap JS will be included at the end of body -->
  </head>
  <body class="bg-light">
    <a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>
    <nav class="navbar navbar-expand-lg navbar-light shadow-sm fixed-top" role="navigation" aria-label="Main navigation" style="background-color: #004225 !important;">
      <div class="container-fluid">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks Logo', class: 'me-2', style: 'width: 100px; height: 100px; object-fit: contain; filter: brightness(1.2) contrast(1.2);' %>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to "Community Ideas", community_ideas_path, class: "nav-link fw-bold", style: 'color: #fff !important;' %>
            </li>
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to "Submit Ideas", new_submission_path, class: "btn btn-primary me-2" %>
              </li>
            <% end %>
            <% if user_signed_in? && current_user.admin? %>
              <li class="nav-item">
                <%= link_to "Admin", admin_root_path, class: "nav-link fw-bold", style: 'color: #ff3333 !important; text-shadow: 0 1px 2px #0002;' %>
              </li>
            <% end %>
          </ul>
          <ul class="navbar-nav">
            <% if user_signed_in? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <div class="rounded-circle" style="background-color: #004225; color: #fff; width: 40px; height: 40px; font-size: 1.2rem; display: flex; align-items: center; justify-content: center;">
                    <%= current_user.email.first.upcase %>
                  </div>
                  <span class="d-none d-md-inline fw-semibold" style="color: #fff;"><%= current_user.email %></span>
                  <% if current_user.admin? %>
                    <span class="badge bg-danger ms-1">Admin</span>
                  <% end %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end animate__animated animate__fadeIn" aria-labelledby="navbarDropdown" style="color: #fff;">
                  <li><%= link_to "My Profile", profile_path, class: "dropdown-item" %></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><%= link_to "Sign Out", destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" %></li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Sign In", new_user_session_path, class: "nav-link fw-bold", style: 'color: #fff !important;' %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-light ms-2 fw-bold", style: 'color: #004225 !important;' %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
    <div style="height: 110px;"></div>
    <main id="main-content" class="container-fluid mt-5 pt-4" tabindex="-1">
      <%= yield %>
    </main>
    <footer class="border-top py-5 mt-5" style="background-color: #004225 !important; color: #fff;">
      <div class="container">
        <div class="row">
          <div class="col-md-4 mb-4">
            <div class="d-flex align-items-center mb-3">
              <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks Logo', class: 'me-2', style: 'width: 100px; height: 100px; object-fit: contain;' %>
            </div>
            <p class="small" style="color: #e0e0e0;">
              Empowering citizens to shape their community through anonymous idea submission and democratic voting.
            </p>
          </div>
          <div class="col-md-4 mb-4">
            <h5 class="fw-bold mb-3" style="color: #fff;">Quick Links</h5>
            <ul class="list-unstyled">
              <li class="mb-2"><%= link_to "Discover Ideas", community_ideas_path, class: "text-decoration-none", style: 'color: #fff !important;' %></li>
              <li class="mb-2"><%= link_to "Submit Idea", new_submission_path, class: "text-decoration-none", style: 'color: #fff !important;' %></li>
              <% if user_signed_in? %>
                <li class="mb-2"><%= link_to "Your Profile", edit_user_registration_path, class: "text-decoration-none", style: 'color: #fff !important;' %></li>
              <% end %>
            </ul>
          </div>
          <div class="col-md-4 mb-4">
            <h5 class="fw-bold mb-3" style="color: #fff;">Community</h5>
            <div class="d-flex gap-3">
              <button class="btn btn-outline-light btn-sm rounded-circle" style="width: 40px; height: 40px; color: #004225; background: #fff; border: 2px solid #fff;" aria-label="Twitter">
                <span aria-hidden="true">T</span>
              </button>
              <button class="btn btn-outline-light btn-sm rounded-circle" style="width: 40px; height: 40px; color: #004225; background: #fff; border: 2px solid #fff;" aria-label="Facebook">
                <span aria-hidden="true">F</span>
              </button>
              <button class="btn btn-outline-light btn-sm rounded-circle" style="width: 40px; height: 40px; color: #004225; background: #fff; border: 2px solid #fff;" aria-label="Instagram">
                <span aria-hidden="true">I</span>
              </button>
            </div>
          </div>
        </div>
        <hr class="my-4">
        <div class="text-center small" style="color: #e0e0e0;">
          <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks Logo', style: 'width: 84px; height: 84px; object-fit: contain; filter: brightness(1.2) contrast(1.2);' %>
          <p class="mt-2">&copy; 2025. Powered by citizens like you.</p>
        </div>
      </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
