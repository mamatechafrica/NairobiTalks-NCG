<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for(:title) || "Nairobi Talks" %></title>
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">

  <!-- Using Tailwind (compiled into application.css) - removed Bootstrap CSS and icons -->
  
  <!-- Trix -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/trix/2.0.0/trix.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</head>

<body class="flex flex-col min-h-screen bg-white">

  <!-- Skip link -->
  <a href="#main-content" class="visually-hidden-focusable position-absolute start-0 mt-2 ms-2 z-3">Skip to main content</a>

  <!-- Navbar (Tailwind) -->
  <nav class="bg-[var(--color-primary)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center">
          <%= link_to root_path, class: "flex items-center" do %>
            <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks', class: 'h-14 w-auto rounded-sm object-contain' %>
          <% end %>
        </div>
        <div class="lg:hidden">
          <button id="nav-toggler" type="button" aria-controls="mainNav" aria-expanded="false" class="inline-flex items-center justify-center p-2 rounded-md text-white" style="border:1px solid rgba(255,255,255,0.18); background: transparent;">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
        <div id="mainNav" class="hidden lg:flex lg:items-center lg:space-x-6">
          <div class="hidden lg:flex lg:items-center lg:space-x-4">
            <%= link_to "Community Ideas", community_ideas_path, class: "bg-white text-[var(--color-primary)] font-semibold px-3 py-2 rounded" %>
          </div>
          <div class="flex items-center space-x-2">
            <%= link_to "Submit Idea", new_submission_path, class: "bg-white text-[var(--color-primary)] font-semibold px-3 py-2 rounded", aria: { label: "Submit a new idea" } %>
            <%= link_to (user_signed_in? ? "Account" : "Sign in"), (user_signed_in? ? profile_path : new_user_session_path), class: "bg-white/90 text-[var(--color-primary)] font-semibold px-3 py-2 rounded" %>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main content ─────────────────────────────────────────────── -->
  <main id="main-content" class="flex-grow-1 py-5" tabindex="-1">
    <div class="container-xl px-3 px-sm-4">
      <%= yield %>
    </div>
  </main>

  <!-- Footer (Tailwind) -->
  <footer class="bg-[var(--color-primary)] text-white py-12 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center mb-4">
            <%= image_tag 'NairobiTalksLogo.png', alt: 'Nairobi Talks', class: 'h-20 w-auto rounded-sm object-contain' %>
          </div>
          <p class="text-white/80 max-w-md">
            Empowering Nairobi citizens to propose, discuss and vote on community ideas — anonymously and democratically.
          </p>
        </div>

        <div>
          <h6 class="uppercase font-semibold mb-3">Explore</h6>
          <ul class="space-y-2 text-sm">
            <li><%= link_to "All Ideas", community_ideas_path, class: "text-white/90 hover:underline" %></li>
            <% if user_signed_in? %>
              <li><%= link_to "Submit Idea", new_submission_path, class: "text-white/90 hover:underline" %></li>
            <% end %>
          </ul>
        </div>

        <div>
          <h6 class="uppercase font-semibold mb-3">Account</h6>
          <ul class="space-y-2 text-sm">
            <% if user_signed_in? %>
              <li><%= link_to "Profile", profile_path, class: "text-white/90 hover:underline" %></li>
              <li><%= link_to "Sign out", destroy_user_session_path, method: :delete, class: "text-white/90 hover:underline" %></li>
            <% else %>
              <li><%= link_to "Sign up", new_user_registration_path, class: "text-white/90 hover:underline" %></li>
            <% end %>
          </ul>
        </div>
      </div>

      <div class="border-t border-white/10 mt-8 pt-6 text-center text-sm text-white/80">
        <p class="mb-1">© <%= Time.current.year %> Nairobi Talks</p>
        <p class="mb-0">Made by citizens • For citizens</p>
      </div>
    </div>
  </footer>

  <script>
    // Mobile nav toggle (no Bootstrap dependency)
    document.addEventListener('DOMContentLoaded', function () {
      var toggler = document.getElementById('nav-toggler');
      var nav = document.getElementById('mainNav');
      if (toggler && nav) {
        toggler.addEventListener('click', function () { nav.classList.toggle('hidden'); });
      }
    });
  </script>
</body>
</html>