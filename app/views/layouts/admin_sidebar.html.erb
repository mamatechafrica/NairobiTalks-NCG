<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Nairobi Talks Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nairobi Talks Admin">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <!-- Admin Layout Wrapper -->
    <div class="admin-layout flex min-h-screen">
      <!-- Fixed Sidebar -->
      <nav class="sidebar fixed left-0 top-0 bottom-0 w-60 flex flex-col z-[1000] bg-[var(--color-primary)] text-[var(--color-primary-foreground)]" aria-label="Admin Navigation" role="navigation">
        <!-- Top Section: Logo (Fixed) -->
        <div class="flex flex-col items-center pt-4 pb-2 px-3 gap-2">
          <img src="<%= asset_path('NairobiTalksLogo.png') %>" alt="Nairobi Talks Admin Logo" class="max-w-[110px] h-auto mb-2 block rounded-md shadow-sm bg-white" />
          <!-- Sidebar Collapse Button -->
          <button id="sidebarCollapseBtn" aria-label="Collapse sidebar" type="button" class="w-full max-w-[110px] flex items-center justify-center mt-1 mb-2 text-white border border-white/20 rounded px-2 py-1">
            <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
            <span class="hidden md:inline ml-2">Collapse</span>
          </button>
        </div>
        <!-- Middle Section: Navigation (Scrollable) -->
        <div class="flex-1 px-3 overflow-y-auto min-h-0 max-h-[calc(100vh-210px)]">
          <ul class="space-y-1" role="menubar">
            <li role="none">
              <%= link_to admin_root_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(admin_root_path)}", role: "menuitem", aria: { label: 'Dashboard' } do %>
                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                <span class="hidden md:inline">Dashboard</span>
              <% end %>
            </li>
            <li role="none">
              <%= link_to admin_app_preview_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(admin_app_preview_path)}", role: "menuitem", aria: { label: 'App Preview' } do %>
                <i class="bi bi-eye" aria-hidden="true"></i>
                <span class="hidden md:inline">App Preview</span>
              <% end %>
            </li>
            <li role="none">
              <%= link_to admin_planning_documents_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(admin_planning_documents_path)}", role: "menuitem", aria: { label: 'Documents' } do %>
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span class="hidden md:inline">Documents</span>
              <% end %>
            </li>
            <li role="none">
              <%= link_to new_admin_planning_document_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(new_admin_planning_document_path)}", role: "menuitem", aria: { label: 'Upload' } do %>
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span class="hidden md:inline">Upload</span>
              <% end %>
            </li>
            <li role="none">
              <%= link_to admin_community_ideas_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(admin_community_ideas_path)}", role: "menuitem", aria: { label: 'Community Ideas' } do %>
                <i class="bi bi-people" aria-hidden="true"></i>
                <span class="hidden md:inline">Community Ideas</span>
              <% end %>
            </li>
            <li role="none">
              <%= link_to admin_analytics_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(admin_analytics_path)}", role: "menuitem", aria: { label: 'Analytics' } do %>
                <i class="bi bi-graph-up" aria-hidden="true"></i>
                <span class="hidden md:inline">Analytics</span>
              <% end %>
            </li>
            <li role="none">
              <%= link_to admin_broadcasts_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(admin_broadcasts_path)}", role: "menuitem", aria: { label: 'Broadcasts' } do %>
                <i class="bi bi-megaphone" aria-hidden="true"></i>
                <span class="hidden md:inline">Broadcasts</span>
              <% end %>
            </li>
            <li role="none">
              <%= link_to admin_forum_path, class: "flex items-center gap-3 px-3 py-2 rounded text-white hover:bg-white/10 w-full #{'bg-white/10' if current_page?(admin_forum_path)}", role: "menuitem", aria: { label: 'Forum' } do %>
                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                <span class="hidden md:inline">Forum</span>
              <% end %>
            </li>
          </ul>
        </div>
        <!-- Bottom Section: Theme Toggle and Logout (Fixed) -->
        <div class="px-3 pb-3 mt-auto">
          <hr class="border-white/20 my-3" aria-hidden="true">
          <!-- Theme Toggle -->
          <div class="flex items-center gap-2 mb-3">
            <input class="h-4 w-4" type="checkbox" id="themeToggle" aria-label="Toggle dark mode">
            <label class="text-white font-medium" for="themeToggle">
              <i class="bi bi-moon-fill mr-1" aria-hidden="true"></i><span class="hidden md:inline">Dark Mode</span>
            </label>
          </div>
          <!-- Logout Button -->
          <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 rounded border border-white/20 text-white font-medium", aria: { label: "Logout from admin panel" } do %>
            <i class="bi bi-power mr-2" aria-hidden="true"></i><span class="hidden md:inline">Logout</span>
          <% end %>
        </div>
      </nav>
      <!-- Main Content Area -->
      <div class="main-content flex-1 flex flex-col ml-[240px] min-h-screen transition-[margin-left] duration-300">
        <!-- Content -->
        <main class="flex-1 p-4 w-full m-0" role="main">
          <%= yield %>
        </main>
        <!-- Footer - Full Width -->
        <footer class="bg-white border-t py-3 text-center text-muted mt-auto" role="contentinfo">
          <div class="max-w-6xl mx-auto px-6">
            <small>© 2025 Nairobi Talks Admin Panel</small>
          </div>
        </footer>
      </div>
    </div>
    <script>
      (() => {
        const themeToggleId = 'themeToggle';
        const sidebarCollapseBtnId = 'sidebarCollapseBtn';
        const sidebarSelector = '.sidebar';
        const mainContentSelector = '.main-content';

        const applyTheme = (theme, toggleElement) => {
          document.documentElement.setAttribute('data-theme', theme);
          document.body.setAttribute('data-theme', theme);
          document.body.classList.toggle('dark-mode', theme === 'dark');
          if (toggleElement) {
            toggleElement.checked = theme === 'dark';
          }
        };

        const initializeThemeToggle = () => {
          const themeToggle = document.getElementById(themeToggleId);
          if (!themeToggle) return;
          const storedTheme = localStorage.getItem('adminTheme') || 'light';
          applyTheme(storedTheme, themeToggle);
          if (themeToggle.dataset.themeInitialized === 'true') return;
          themeToggle.dataset.themeInitialized = 'true';
          themeToggle.addEventListener('change', (event) => {
            const nextTheme = event.currentTarget.checked ? 'dark' : 'light';
            localStorage.setItem('adminTheme', nextTheme);
            applyTheme(nextTheme, event.currentTarget);
          });
        };

        const initializeSidebarCollapse = () => {
          const sidebar = document.querySelector(sidebarSelector);
          const mainContent = document.querySelector(mainContentSelector);
          const collapseBtn = document.getElementById(sidebarCollapseBtnId);
          if (!sidebar || !mainContent || !collapseBtn) return;
          collapseBtn.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
            mainContent.style.marginLeft = sidebar.classList.contains('collapsed') ? '60px' : '240px';
            // Change icon direction
            const icon = collapseBtn.querySelector('i');
            if (sidebar.classList.contains('collapsed')) {
              icon.classList.remove('bi-chevron-double-left');
              icon.classList.add('bi-chevron-double-right');
              collapseBtn.setAttribute('aria-label', 'Expand sidebar');
              collapseBtn.querySelector('span').textContent = 'Expand';
            } else {
              icon.classList.remove('bi-chevron-double-right');
              icon.classList.add('bi-chevron-double-left');
              collapseBtn.setAttribute('aria-label', 'Collapse sidebar');
              collapseBtn.querySelector('span').textContent = 'Collapse';
            }
          });
        };

        document.addEventListener('DOMContentLoaded', () => {
          initializeThemeToggle();
          initializeSidebarCollapse();
        });
        document.addEventListener('turbo:load', () => {
          initializeThemeToggle();
          initializeSidebarCollapse();
        });
        if (document.readyState !== 'loading') {
          initializeThemeToggle();
          initializeSidebarCollapse();
        }
      })();
    </script>
  </body>
</html>