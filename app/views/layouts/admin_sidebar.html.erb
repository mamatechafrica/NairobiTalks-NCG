<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Nairobi Talks Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nairobi Talks Admin">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <%= stylesheet_link_tag "application", "admin", "application.tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <!-- Admin Layout Wrapper -->
    <div class="admin-layout">
      <!-- Fixed Sidebar -->
      <nav class="sidebar" aria-label="Admin Navigation" role="navigation">
        <!-- Logo Section -->
        <div class="sidebar-header">
          <img src="<%= asset_path('NairobiTalksLogo.png') %>" alt="Nairobi Talks Admin Logo" class="sidebar-logo" />
          <h6 class="sidebar-title">Admin Panel</h6>
        </div>
        <!-- Navigation Menu -->
        <div class="sidebar-nav">
          <ul class="nav-list" role="menubar">
            <li class="nav-item" role="none">
              <%= link_to admin_dashboard_path, class: "nav-link #{' active' if current_page?(admin_dashboard_path)}", aria_current: current_page?(admin_dashboard_path) ? 'page' : nil, role: "menuitem", aria: { label: 'Dashboard' } do %>
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
              <% end %>
            </li>
            <li class="nav-item" role="none">
              <%= link_to admin_app_preview_path, class: "nav-link #{' active' if current_page?(admin_app_preview_path)}", aria_current: current_page?(admin_app_preview_path) ? 'page' : nil, role: "menuitem", aria: { label: 'App Preview' } do %>
                <i class="bi bi-eye"></i>
                <span>App Preview</span>
              <% end %>
            </li>
            <li class="nav-item" role="none">
              <%= link_to admin_planning_documents_path, class: "nav-link #{' active' if current_page?(admin_planning_documents_path)}", aria_current: current_page?(admin_planning_documents_path) ? 'page' : nil, role: "menuitem", aria: { label: 'Documents' } do %>
                <i class="bi bi-file-earmark-text"></i>
                <span>Documents</span>
              <% end %>
            </li>
            <li class="nav-item" role="none">
              <%= link_to new_admin_planning_document_path, class: "nav-link #{' active' if current_page?(new_admin_planning_document_path)}", aria_current: current_page?(new_admin_planning_document_path) ? 'page' : nil, role: "menuitem", aria: { label: 'Upload' } do %>
                <i class="bi bi-upload"></i>
                <span>Upload</span>
              <% end %>
            </li>
            <li class="nav-item" role="none">
              <%= link_to admin_community_ideas_path, class: "nav-link #{' active' if current_page?(admin_community_ideas_path)}", aria_current: current_page?(admin_community_ideas_path) ? 'page' : nil, role: "menuitem", aria: { label: 'Community Ideas' } do %>
                <i class="bi bi-people"></i>
                <span>Community Ideas</span>
              <% end %>
            </li>
            <li class="nav-item" role="none">
              <%= link_to admin_analytics_path, class: "nav-link #{' active' if current_page?(admin_analytics_path)}", aria_current: current_page?(admin_analytics_path) ? 'page' : nil, role: "menuitem", aria: { label: 'Analytics' } do %>
                <i class="bi bi-graph-up"></i>
                <span>Analytics</span>
              <% end %>
            </li>
            <li class="nav-item" role="none">
              <%= link_to admin_broadcasts_path, class: "nav-link #{' active' if current_page?(admin_broadcasts_path)}", aria_current: current_page?(admin_broadcasts_path) ? 'page' : nil, role: "menuitem", aria: { label: 'Broadcasts' } do %>
                <i class="bi bi-megaphone"></i>
                <span>Broadcasts</span>
              <% end %>
            </li>
            <li class="nav-item" role="none">
              <%= link_to admin_forum_path, class: "nav-link #{' active' if current_page?(admin_forum_path)}", aria_current: current_page?(admin_forum_path) ? 'page' : nil, role: "menuitem", aria: { label: 'Forum' } do %>
                <i class="bi bi-calendar-event"></i>
                <span>Forum</span>
              <% end %>
            </li>
          </ul>
        </div>
        <!-- Bottom Section: User Info & Actions -->
        <div class="sidebar-footer">
          <hr class="sidebar-divider">
          <!-- User Info -->
          <div class="user-section">
            <div class="user-avatar">
              <i class="bi bi-person-circle"></i>
            </div>
            <div class="user-details">
              <small class="user-role text-light font-bold">Administrator</small>
              <div class="user-name text-light font-bold"><%= current_user&.email&.split('@')&.first || 'Admin' %></div>
            </div>
          </div>
          <!-- Theme Toggle -->
          <!-- <div class="theme-toggle">
            <label class="switch">
              <input type="checkbox" id="themeToggle" aria-label="Toggle dark mode">
              <span class="slider">
                <i class="bi bi-sun icon-light"></i>
                <i class="bi bi-moon icon-dark"></i>
              </span>
            </label>
            <small>Theme</small>
          </div> -->
          <!-- Logout -->
          <%= button_to destroy_user_session_path, method: :delete, class: "logout-btn", aria: { label: "Logout from admin panel" } do %>
            <i class="bi bi-power"></i>
            <span>Logout</span>
          <% end %>
        </div>
      </nav>
      <!-- Main Content Area -->
      <div class="main-content">
        <!-- Top Bar -->
        <header class="content-header">
          <div class="header-left">
            <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
              <i class="bi bi-list"></i>
            </button>
            <h1 class="page-title"><%= content_for(:title) || "Dashboard" %></h1>
          </div>
          <div class="header-right">
            <%= link_to "View Site", root_path, class: "view-site-btn", target: "_blank" %>
          </div>
        </header>
        <!-- Page Content -->
        <main class="content-main">
          <%= yield %>
        </main>
      </div>
    </div>
    <script>
      (() => {
        const themeToggle = document.getElementById('themeToggle');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.querySelector('.sidebar');
        const mainContent = document.querySelector('.main-content');

        // Theme Management
        const applyTheme = (theme) => {
          document.documentElement.setAttribute('data-theme', theme);
          document.body.classList.toggle('dark-mode', theme === 'dark');
          if (themeToggle) {
            themeToggle.checked = theme === 'dark';
          }
          localStorage.setItem('adminTheme', theme);
        };

        // Initialize theme
        const savedTheme = localStorage.getItem('adminTheme') || 'light';
        applyTheme(savedTheme);

        // Theme toggle listener
        if (themeToggle) {
          themeToggle.addEventListener('change', () => {
            applyTheme(themeToggle.checked ? 'dark' : 'light');
          });
        }

        // Sidebar Management
        const toggleSidebar = () => {
          sidebar.classList.toggle('collapsed');
          // Update main content margin
          if (sidebar.classList.contains('collapsed')) {
            mainContent.style.marginLeft = '0';
          } else {
            mainContent.style.marginLeft = '280px';
          }
          localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
        };

        // Initialize sidebar state
        const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
        if (sidebarCollapsed) {
          sidebar.classList.add('collapsed');
          mainContent.style.marginLeft = '0';
        }

        // Sidebar toggle listener
        if (sidebarToggle) {
          sidebarToggle.addEventListener('click', toggleSidebar);
        }

        // Handle responsive sidebar
        const handleResponsive = () => {
          if (window.innerWidth <= 991) {
            sidebar.classList.add('collapsed');
            mainContent.style.marginLeft = '0';
          } else if (!localStorage.getItem('sidebarCollapsed')) {
            sidebar.classList.remove('collapsed');
            mainContent.style.marginLeft = '280px';
          }
        };

        window.addEventListener('resize', handleResponsive);
        handleResponsive();

        // Initialize on Turbo loads
        document.addEventListener('turbo:load', () => {
          applyTheme(savedTheme);
          if (themeToggle) {
            themeToggle.checked = savedTheme === 'dark';
          }
        });
      })();
    </script>
  </body>
</html>
