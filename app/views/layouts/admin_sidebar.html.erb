<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Nairobi Talks Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nairobi Talks Admin">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body>
    <!-- Admin Layout Wrapper -->
    <div class="admin-layout d-flex" style="min-height: 100vh;">
      <!-- Fixed Sidebar -->
      <nav class="sidebar d-flex flex-column justify-content-between" style="width: 240px; position: fixed; left: 0; top: 0; bottom: 0; z-index: 1000;" aria-label="Admin Navigation">
        <!-- Top Section: Logo and Navigation -->
        <div>
          <div class="text-center py-4 px-3">
            <h5 class="fw-bold text-white mb-0" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3);" aria-label="Nairobi Talks Admin Panel">
              Nairobi Talks<br>
              <small class="fw-normal">Admin</small>
            </h5>
          </div>
          <ul class="nav flex-column px-3">
            <li class="nav-item mb-2">
              <%= link_to '<i class="bi bi-speedometer2 me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Dashboard</span>'.html_safe, admin_root_path, class: "nav-link", aria_current: current_page?(admin_root_path) ? 'page' : nil %>
            </li>
            <li class="nav-item mb-2">
              <%= link_to '<i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Documents</span>'.html_safe, admin_planning_documents_path, class: "nav-link", aria_current: current_page?(admin_planning_documents_path) ? 'page' : nil %>
            </li>
            <li class="nav-item mb-2">
              <%= link_to '<i class="bi bi-upload me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Upload</span>'.html_safe, new_admin_planning_document_path, class: "nav-link", aria_current: current_page?(new_admin_planning_document_path) ? 'page' : nil %>
            </li>
            <li class="nav-item mb-2">
              <%= link_to '<i class="bi bi-people me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Community Ideas</span>'.html_safe, admin_submissions_path, class: "nav-link", aria_current: current_page?(admin_submissions_path) ? 'page' : nil %>
            </li>
            <li class="nav-item mb-2">
              <%= link_to '<i class="bi bi-graph-up me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Analytics</span>'.html_safe, admin_analytics_path, class: "nav-link", aria_current: current_page?(admin_analytics_path) ? 'page' : nil %>
            </li>
            <li class="nav-item mb-2">
              <%= link_to '<i class="bi bi-megaphone me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Broadcasts</span>'.html_safe, admin_broadcasts_path, class: "nav-link", aria_current: current_page?(admin_broadcasts_path) ? 'page' : nil %>
            </li>
            <li class="nav-item mb-2">
              <%= link_to '<i class="bi bi-calendar-event me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Forum</span>'.html_safe, admin_forum_path, class: "nav-link", aria_current: current_page?(admin_forum_path) ? 'page' : nil %>
            </li>
          </ul>
        </div>
        <!-- Bottom Section: Theme Toggle and Logout -->
        <div class="px-3 pb-3">
          <hr class="border-white-50 my-3" aria-hidden="true">
          <!-- Theme Toggle -->
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="themeToggle" aria-label="Toggle dark mode">
            <label class="form-check-label text-white fw-medium" for="themeToggle">
              <i class="bi bi-moon-fill me-1" aria-hidden="true"></i><span class="d-none d-md-inline">Dark Mode</span>
            </label>
          </div>
          <!-- Logout Button -->
          <%= link_to '<i class="bi bi-power me-2" aria-hidden="true"></i><span class="d-none d-md-inline">Logout</span>'.html_safe, destroy_user_session_path, method: :delete, class: "btn logout-btn w-100 fw-medium", aria_label: "Logout from admin panel" %>
        </div>
      </nav>
      <!-- Main Content Area -->
      <div class="main-content flex-grow-1 d-flex flex-column" style="margin-left: 240px; min-height: 100vh;">
        <!-- Content -->
        <main class="flex-grow-1 p-4" role="main">
          <%= yield %>
        </main>
        <!-- Footer - Full Width -->
        <footer class="bg-light border-top py-3 text-center text-muted mt-auto" role="contentinfo">
          <div class="container-fluid">
            <small>© 2025 Nairobi Talks Admin Panel</small>
          </div>
        </footer>
      </div>
    </div>
    <%= javascript_importmap_tags %>
    <script>
      (() => {
        const themeToggleId = 'themeToggle';

        const applyTheme = (theme, toggleElement) => {
          document.documentElement.setAttribute('data-theme', theme);
          document.body.setAttribute('data-theme', theme);
          document.body.classList.toggle('dark-mode', theme === 'dark');

          if (toggleElement) {
            toggleElement.checked = theme === 'dark';
          }
        };

        const initializeThemeToggle = () => {
          const themeToggle = document.getElementById(themeToggleId);
          if (!themeToggle) {
            return;
          }

          const storedTheme = localStorage.getItem('adminTheme') || 'light';
          applyTheme(storedTheme, themeToggle);

          if (themeToggle.dataset.themeInitialized === 'true') {
            return;
          }

          themeToggle.dataset.themeInitialized = 'true';
          themeToggle.addEventListener('change', (event) => {
            const nextTheme = event.currentTarget.checked ? 'dark' : 'light';
            localStorage.setItem('adminTheme', nextTheme);
            applyTheme(nextTheme, event.currentTarget);
          });
        };

        document.addEventListener('DOMContentLoaded', initializeThemeToggle);
        document.addEventListener('turbo:load', initializeThemeToggle);

        if (document.readyState !== 'loading') {
          initializeThemeToggle();
        }
      })();
    </script>
  </body>
</html>