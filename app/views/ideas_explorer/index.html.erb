<div class="ideas-explorer-page bg-[#edf6f2] py-10">
  <div class="container mx-auto px-6 lg:px-12">
    <%= render partial: 'shared/header', locals: { title: 'Explore Ideas' } %>
    <p class="text-lg text-gray-600 mt-4 text-center">Search and filter ideas to find what inspires you.</p>
    <!-- Combined Search and Filter Bar (Bootstrap style) -->
    <div class="container mb-4">
      <form action="<%= ideas_explorer_path %>" method="get" class="flex flex-wrap gap-3 items-end p-3 rounded shadow-sm bg-white border-2 border-success">
        <div class="md:w-1/4 w-1/2">
          <label for="query" class="block font-bold text-[#004225]">Search</label>
          <input type="text" name="query" id="query" value="<%= params[:query] %>" class="block w-full rounded-md border-2 border-success px-3 py-2 font-bold bg-[#f8fff8] text-[#004225]" placeholder="Search ideas..." />
        </div>
        <div class="md:w-1/6 w-1/2">
          <label for="topic" class="block font-bold text-[#004225]">Topic</label>
          <select name="topic" id="topic" class="block w-full rounded-md border-2 border-success px-3 py-2 font-bold bg-[#f8fff8] text-[#004225]">
            <option value="">All</option>
            <option value="transportation" <%= 'selected' if params[:topic] == 'transportation' %>>Transportation</option>
            <option value="education" <%= 'selected' if params[:topic] == 'education' %>>Education</option>
            <option value="health" <%= 'selected' if params[:topic] == 'health' %>>Health</option>
          </select>
        </div>
        <div class="md:w-1/6 w-1/2">
          <label for="sort" class="block font-bold text-[#004225]">Sort By</label>
          <select name="sort" id="sort" class="block w-full rounded-md border-2 border-success px-3 py-2 font-bold bg-[#f8fff8] text-[#004225]">
            <option value="recent" <%= 'selected' if params[:sort] == 'recent' %>>Most Recent</option>
            <option value="popular" <%= 'selected' if params[:sort] == 'popular' %>>Most Popular</option>
          </select>
        </div>
        <div class="md:w-1/6 w-full flex items-end">
          <button type="submit" class="inline-block w-full py-3 rounded bg-[#004225] text-white font-bold">Search</button>
        </div>
      </form>
    </div>

    <!-- Results Section -->
    <div class="results-section">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @ideas.each do |idea| %>
          <%= render partial: "community_ideas/idea_card", locals: { idea: idea } %>
        <% end %>
        <% if @ideas.empty? %>
          <p class="text-center text-gray-600 mt-8">No ideas found. Try adjusting your filters or search query.</p>
        <% end %>
      </div>
    </div>
  </div>