<div class="min-h-screen bg-background py-8 font-body">
  <div class="max-w-4xl mx-auto px-6">
    <div class="mb-8 text-center">
      <h1 class="font-heading font-bold text-3xl md:text-4xl text-primary mb-2">
        Explore Ideas
      </h1>
      <p class="text-muted-foreground text-base md:text-lg">
        Swipe through community ideas and find inspiration.
      </p>
    </div>
    <div class="swiper-container">
      <div class="swiper-wrapper">
        <!-- Example Slide -->
        <div class="swiper-slide bg-card rounded-xl shadow-elevation-2 p-6">
          <h2 class="font-heading text-xl text-primary mb-2">Idea Title</h2>
          <p class="text-muted-foreground text-sm mb-4">
            Brief description of the idea goes here. It should be concise and engaging.
          </p>
          <a href="#" class="text-primary font-semibold hover:underline">Read More</a>
        </div>
        <!-- Add more slides dynamically -->
      </div>
      <!-- Pagination -->
      <div class="swiper-pagination"></div>
      <!-- Navigation Buttons -->
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('turbo:load', function() {
    const swiper = new Swiper('.swiper-container', {
      loop: true,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>