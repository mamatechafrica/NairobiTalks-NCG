<div class="bg-base-100">
  <!-- Hero Section (Nairobi skyline background) -->
  <section class="relative text-white h-screen min-h-screen bg-cover bg-center flex items-center" role="region" aria-label="Hero" style="background-image: url('<%= asset_path "hero-landing.jpg" %>'); background-repeat: no-repeat; background-size: cover; background-position: center center;">
    <!-- lighter mask so the image is more visible while keeping text readable -->
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 text-center">
      <div class="w-full bg-white/70 backdrop-blur-sm rounded p-6 text-black" style="background-color: rgba(255,255,255,0.75); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);">
        <div class="mx-auto mb-6">
          <div class="flex flex-col md:flex-row items-center gap-4 justify-center">
        <div class="text-center md:text-left">
          <h1 class="text-4xl md:text-6xl font-extrabold mb-2 drop-shadow-lg">Nairobi Talks</h1>
          <p class="text-lg md:text-xl max-w-2xl">Empowering citizens to shape their community through anonymous idea submission and democratic voting.</p>
        </div>
          </div>
          <div class="mt-6 flex items-center justify-center">
        <%= render 'admin/shared/button', href: new_submission_path, variant: 'success', extra_classes: 'px-6 py-3 rounded text-lg focus:outline-none focus:ring-4 focus:ring-success/40' do %>
          Submit an idea
        <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick stats -->
  <section class="py-8 bg-white" aria-label="Quick statistics">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center items-stretch" role="list">
        <div class="p-6 bg-white border rounded-lg shadow-sm flex flex-col items-center justify-center" role="listitem" aria-label="Ideas Submitted">
          <h2 class="text-5xl md:text-6xl font-extrabold text-success leading-none" role="status" aria-live="polite"><%= number_with_delimiter(CommunityIdea.count) %></h2>
          <p class="mt-2 text-sm text-gray-500">Ideas Submitted</p>
        </div>
        <div class="p-6 bg-white border rounded-lg shadow-sm flex flex-col items-center justify-center" role="listitem" aria-label="Comments Made">
          <h2 class="text-5xl md:text-6xl font-extrabold text-success leading-none" role="status" aria-live="polite"><%= number_with_delimiter(Comment.count) %></h2>
          <p class="mt-2 text-sm text-gray-500">Comments Made</p>
        </div>
        <div class="p-6 bg-white border rounded-lg shadow-sm flex flex-col items-center justify-center" role="listitem" aria-label="Citizens Engaged">
          <h2 class="text-5xl md:text-6xl font-extrabold text-success leading-none" role="status" aria-live="polite"><%= number_with_delimiter(User.count) %></h2>
          <p class="mt-2 text-sm text-gray-500">Citizens Engaged</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-12 bg-[var(--color-background)]">
    <div class="max-w-6xl mx-auto px-6 text-center mb-10">
      <h2 class="text-2xl font-bold mb-2">How It Works</h2>
      <p class="text-gray-600 mb-6">Three simple steps to make your voice heard</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% [
          { title: 'Submit Your Idea', desc: 'Share your thoughts on how to improve Nairobi.' , n: 1 },
          { title: 'Community Discussion', desc: 'Engage with fellow citizens — comment and refine ideas.', n: 2 },
          { title: 'Vote & Impact', desc: 'Vote on ideas you support; popular ideas get attention.', n: 3 }
        ].each do |item| %>
          <div class="text-center">
            <div class="bg-success text-white inline-flex items-center justify-center mb-3 h-20 w-20 mx-auto rounded-full">
              <span class="font-bold text-xl"><%= item[:n] %></span>
            </div>
            <h4 class="font-bold mb-3"><%= item[:title] %></h4>
            <p class="text-gray-600"><%= item[:desc] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Recent Ideas Preview -->
  <section class="py-8 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-6">
        <h2 class="text-xl font-semibold mb-1">Recent Community Ideas</h2>
        <p class="text-gray-500">See what Nairobi citizens are talking about</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% CommunityIdea.order(created_at: :desc).limit(3).each do |idea| %>
          <div class="bg-base-100 shadow rounded-lg overflow-hidden">
            <% img = if idea.respond_to?(:image_url) && idea.image_url.present?
                        # If the stored value points to an Unsplash photo page, convert to a direct image URL
                        if idea.image_url =~ %r{unsplash.com/photos/([^/?]+)}
                          "https://source.unsplash.com/#{$1}/800x600"
                        else
                          idea.image_url
                        end
                      else
                        # fallback direct image URL (images.unsplash.com) for reliable rendering
                        "https://images.unsplash.com/photo-1496307042754-b4aa456c4a2d?auto=format&fit=crop&w=800&q=60"
                      end %>
            <div class="h-40 w-full overflow-hidden">
              <img src="<%= img %>" alt="<%= idea.title %>" class="w-full h-full object-cover">
            </div>
            <div class="p-4">
              <h5 class="text-lg font-semibold text-success"><%= idea.title %></h5>
              <p class="text-sm text-gray-600 mt-2"><%= idea.description.truncate(120) %></p>
              <div class="flex items-center justify-between mt-3 text-sm text-gray-500">
                <small><%= time_ago_in_words(idea.created_at) %> ago</small>
                <span class="inline-block bg-success text-white text-xs px-2 py-1 rounded"><%= idea.comments.count %> comments</span>
              </div>
            </div>
            <div class="p-3 bg-transparent">
              <%= link_to 'Read More', community_idea_path(idea), class: 'inline-block w-full text-center px-3 py-2 border border-success text-success rounded' %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="text-center mt-6">
        <%= render 'admin/shared/button', href: community_ideas_path, variant: 'success', extra_classes: 'btn-lg' do %>
          View All Ideas
        <% end %>
      </div>
    </div>
  </section>

</div>

<!-- Privacy & Trust -->
<section class="py-16 bg-[var(--color-muted)]">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-heading font-bold text-3xl text-[var(--color-primary)] mb-8">
      Privacy & Trust
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Secure</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Your data is safe with us.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Anonymous</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Submit ideas without revealing your identity.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Transparent</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">See how decisions are made.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Trusted</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Join a community you can trust.</p>
      </div>
    </div>
  </div>
</section>