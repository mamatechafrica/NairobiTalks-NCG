<div class="bg-[var(--color-background)] min-h-screen">
  <!-- Hero Section -->
  <section class="bg-[var(--color-primary)] text-white py-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex justify-center text-center">
        <div class="w-full lg:w-8/12">
          <div class="bg-white rounded flex items-center justify-center mr-3 mb-4 w-20 h-20">
            <span class="text-[var(--color-primary)] font-bold text-2xl">NT</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">
            Nairobi Talks
          </h1>
          <p class="text-lg mb-8 text-white/90">
            Empowering citizens to shape their community through anonymous idea submission and democratic voting.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Access Cards Section -->
  <section class="py-5">
    <!-- Cards removed as requested -->
  </section>
  <!-- Footer -->
  <footer class="bg-white border-t py-4 mt-5">
    <div class="container text-center">
      <p class="text-muted mb-0">
        <small>© 2025 Nairobi Talks - Empowering Community Voices</small>
      </p>
    </div>
  </footer>
</div>
<section class="py-12 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-wrap -mx-4 text-center">
      <div class="w-full md:w-1/3 px-4 mb-4">
        <div class="h-full p-6 border rounded-lg">
          <h2 class="text-[var(--color-primary)] font-bold text-4xl"><%= CommunityIdea.count %></h2>
          <p class="text-muted mb-0">Ideas Submitted</p>
        </div>
      </div>
      <div class="w-full md:w-1/3 px-4 mb-4">
        <div class="h-full p-6 border rounded-lg">
          <h2 class="text-[var(--color-primary)] font-bold text-4xl"><%= Comment.count %></h2>
          <p class="text-muted mb-0">Comments Made</p>
        </div>
      </div>
      <div class="w-full md:w-1/3 px-4 mb-4">
        <div class="h-full p-6 border rounded-lg">
          <h2 class="text-[var(--color-primary)] font-bold text-4xl"><%= User.count %></h2>
          <p class="text-muted mb-0">Citizens Engaged</p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Features Section -->
<section class="py-12 bg-[var(--color-muted)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-8">
      <h2 class="font-bold mb-3">How It Works</h2>
      <p class="text-muted">Three simple steps to make your voice heard</p>
    </div>
    <div class="flex flex-wrap -mx-4">
      <div class="w-full md:w-1/3 px-4 mb-4">
        <div class="text-center">
          <div class="bg-[var(--color-primary)] text-white rounded-full inline-flex items-center justify-center mb-3 w-20 h-20">
            <span class="font-bold text-lg">1</span>
          </div>
          <h4 class="font-bold mb-3">Submit Your Idea</h4>
          <p class="text-muted">Share your thoughts on how to improve Nairobi. From transportation to education, every idea counts.</p>
        </div>
      </div>
      <div class="w-full md:w-1/3 px-4 mb-4">
        <div class="text-center">
          <div class="bg-[var(--color-primary)] text-white rounded-full inline-flex items-center justify-center mb-3 w-20 h-20">
            <span class="font-bold text-lg">2</span>
          </div>
          <h4 class="font-bold mb-3">Community Discussion</h4>
          <p class="text-muted">Engage with fellow citizens. Comment, debate, and refine ideas together.</p>
        </div>
      </div>
      <div class="w-full md:w-1/3 px-4 mb-4">
        <div class="text-center">
          <div class="bg-[var(--color-primary)] text-white rounded-full inline-flex items-center justify-center mb-3 w-20 h-20">
            <span class="font-bold text-lg">3</span>
          </div>
          <h4 class="font-bold mb-3">Vote & Impact</h4>
          <p class="text-muted">Vote on ideas you support. Popular ideas get attention from local government.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Recent Ideas Preview -->
<section class="py-12 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-8 text-center">
      <h2 class="font-bold mb-3">Recent Community Ideas</h2>
      <p class="text-muted">See what Nairobi citizens are talking about</p>
    </div>
    <div class="flex flex-wrap -mx-4">
      <% CommunityIdea.order(created_at: :desc).limit(3).each do |idea| %>
        <div class="w-full md:w-1/3 px-4 mb-4">
          <div class="bg-white h-100 border-0 shadow-sm rounded-lg overflow-hidden">
            <div class="p-6">
              <h5 class="font-bold text-[var(--color-primary)]"><%= idea.title %></h5>
              <p class="text-muted"><%= idea.description.truncate(100) %></p>
              <div class="flex justify-between items-center mt-3">
                <small class="text-muted">
                  <%= time_ago_in_words(idea.created_at) %> ago
                </small>
                <span class="inline-flex items-center bg-[var(--color-primary)] text-white text-sm font-medium px-2 py-1 rounded">
                  <%= idea.comments.count %> comments
                </span>
              </div>
            </div>
            <div class="bg-white border-t">
              <%= link_to "Read More", community_idea_path(idea), class: "inline-block px-3 py-2 text-[var(--color-primary)] border border-[var(--color-primary)] rounded-sm mx-4 my-3" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="text-center mt-6">
      <%= link_to "View All Ideas", community_ideas_path, class: "inline-block px-6 py-3 rounded-lg bg-[var(--color-primary)] text-white text-lg" %>
    </div>
  </div>
</section>
<!-- CTA Section -->
<section class="bg-[var(--color-primary)] text-white py-12">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-bold mb-3">Ready to Make a Difference?</h2>
    <p class="text-lg mb-6">Join thousands of Nairobi citizens shaping the future of our city.</p>
    <% if user_signed_in? %>
      <%= link_to "Go to Dashboard", dashboard_user_path, class: "inline-block px-6 py-3 rounded-lg bg-white text-[var(--color-primary)] font-medium mr-3" %>
      <%= link_to "Submit New Idea", new_submission_path, class: "inline-block px-6 py-3 rounded-lg border border-white text-white" %>
    <% else %>
      <%= link_to "Sign Up Now", new_user_registration_path, class: "inline-block px-6 py-3 rounded-lg bg-white text-[var(--color-primary)] font-medium mr-3" %>
      <%= link_to "Learn More", "#", class: "inline-block px-6 py-3 rounded-lg border border-white text-white" %>
    <% end %>
  </div>
</section>
</div>
</section>
<!-- How It Works -->
<section class="py-16 bg-[var(--color-background)]">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-heading font-bold text-3xl text-[var(--color-primary)] mb-8">
      How It Works
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Submit Ideas</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Share your vision for the community.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Vote on Ideas</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Support the ideas you believe in.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Make a Difference</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Help shape the future of your community.</p>
      </div>
    </div>
  </div>
</section>
<!-- Privacy & Trust -->
<section class="py-16 bg-[var(--color-muted)]">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-heading font-bold text-3xl text-[var(--color-primary)] mb-8">
      Privacy & Trust
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Secure</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Your data is safe with us.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Anonymous</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Submit ideas without revealing your identity.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Transparent</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">See how decisions are made.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Trusted</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Join a community you can trust.</p>
      </div>
    </div>
    <div class="mt-8">
      <span class="inline-block bg-[var(--color-primary)] text-[var(--color-primary-foreground)] text-sm font-medium px-4 py-2 rounded-full">
        Trusted by 10,000+ users
      </span>
    </div>
  </div>
</section>
<!-- Final CTA -->
<section class="py-16 bg-[var(--color-background)]">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-heading font-bold text-3xl text-[var(--color-primary)] mb-8">
      Ready to Make a Difference?
    </h2>
    <a href="#" class="px-8 py-4 rounded-full bg-[var(--color-primary)] text-[var(--color-primary-foreground)] font-medium hover:bg-[var(--color-secondary)] transition">
      Get Started
    </a>
  </div>
</section>
<!-- Footer -->
<footer class="bg-[var(--color-muted)] py-8">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="text-[var(--color-muted-foreground)] text-sm">
      © 2025 Nairobi Talks. All rights reserved.
    </p>
  </div>
</footer>
</div>