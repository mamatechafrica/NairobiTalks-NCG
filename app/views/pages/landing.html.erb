<div class="bg-light min-vh-100">
  <!-- Hero Section -->
  <section class="bg-success text-white py-5">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-lg-8">
          <div class="bg-white rounded d-flex align-items-center justify-content-center me-3 mb-4" style="width: 80px; height: 80px;">
            <span class="text-success fw-bold fs-2">NT</span>
          </div>
          <h1 class="display-4 fw-bold mb-4">
            Nairobi Talks
          </h1>
          <p class="lead mb-5">
            Empowering citizens to shape their community through anonymous idea submission and democratic voting.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Access Cards Section -->
  <section class="py-5">
    <!-- Cards removed as requested -->
  </section>
  <!-- Footer -->
  <footer class="bg-white border-top py-4 mt-5">
    <div class="container text-center">
      <p class="text-muted mb-0">
        <small>© 2025 Nairobi Talks - Empowering Community Voices</small>
      </p>
    </div>
  </footer>
</div>
<section class="py-5 bg-white">
  <div class="container">
    <div class="row text-center">
      <div class="col-md-4 mb-4">
        <div class="h-100 p-4 border rounded">
          <h2 class="text-success fw-bold display-4"><%= CommunityIdea.count %></h2>
          <p class="text-muted mb-0">Ideas Submitted</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="h-100 p-4 border rounded">
          <h2 class="text-success fw-bold display-4"><%= Comment.count %></h2>
          <p class="text-muted mb-0">Comments Made</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="h-100 p-4 border rounded">
          <h2 class="text-success fw-bold display-4"><%= User.count %></h2>
          <p class="text-muted mb-0">Citizens Engaged</p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Features Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row text-center mb-5">
      <div class="col-12">
        <h2 class="fw-bold mb-3">How It Works</h2>
        <p class="text-muted lead">Three simple steps to make your voice heard</p>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4 mb-4">
        <div class="text-center">
          <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <span class="fw-bold fs-4">1</span>
          </div>
          <h4 class="fw-bold mb-3">Submit Your Idea</h4>
          <p class="text-muted">Share your thoughts on how to improve Nairobi. From transportation to education, every idea counts.</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="text-center">
          <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <span class="fw-bold fs-4">2</span>
          </div>
          <h4 class="fw-bold mb-3">Community Discussion</h4>
          <p class="text-muted">Engage with fellow citizens. Comment, debate, and refine ideas together.</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="text-center">
          <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <span class="fw-bold fs-4">3</span>
          </div>
          <h4 class="fw-bold mb-3">Vote & Impact</h4>
          <p class="text-muted">Vote on ideas you support. Popular ideas get attention from local government.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Recent Ideas Preview -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="row mb-5">
      <div class="col-12 text-center">
        <h2 class="fw-bold mb-3">Recent Community Ideas</h2>
        <p class="text-muted lead">See what Nairobi citizens are talking about</p>
      </div>
    </div>
    <div class="row">
      <% CommunityIdea.order(created_at: :desc).limit(3).each do |idea| %>
        <div class="col-md-4 mb-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h5 class="card-title fw-bold text-success"><%= idea.title %></h5>
              <p class="card-text text-muted"><%= idea.description.truncate(100) %></p>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted">
                  <%= time_ago_in_words(idea.created_at) %> ago
                </small>
                <span class="badge bg-success">
                  <%= idea.comments.count %> comments
                </span>
              </div>
            </div>
            <div class="card-footer bg-transparent border-0">
              <%= link_to "Read More", community_idea_path(idea), class: "btn btn-outline-success btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="text-center mt-4">
      <%= link_to "View All Ideas", community_ideas_path, class: "btn btn-success btn-lg" %>
    </div>
  </div>
</section>
<!-- CTA Section -->
<section class="bg-success text-white py-5">
  <div class="container text-center">
    <h2 class="fw-bold mb-3">Ready to Make a Difference?</h2>
    <p class="lead mb-4">Join thousands of Nairobi citizens shaping the future of our city.</p>
    <% if user_signed_in? %>
      <%= link_to "Go to Dashboard", dashboard_user_path, class: "btn btn-light btn-lg me-3" %>
      <%= link_to "Submit New Idea", new_submission_path, class: "btn btn-outline-light btn-lg" %>
    <% else %>
      <%= link_to "Sign Up Now", new_user_registration_path, class: "btn btn-light btn-lg me-3" %>
      <%= link_to "Learn More", "#", class: "btn btn-outline-light btn-lg" %>
    <% end %>
  </div>
</section>
</div>
</section>
<!-- How It Works -->
<section class="py-16 bg-[var(--color-background)]">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-heading font-bold text-3xl text-[var(--color-primary)] mb-8">
      How It Works
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Submit Ideas</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Share your vision for the community.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Vote on Ideas</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Support the ideas you believe in.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Make a Difference</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Help shape the future of your community.</p>
      </div>
    </div>
  </div>
</section>
<!-- Privacy & Trust -->
<section class="py-16 bg-[var(--color-muted)]">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-heading font-bold text-3xl text-[var(--color-primary)] mb-8">
      Privacy & Trust
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Secure</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Your data is safe with us.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Anonymous</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Submit ideas without revealing your identity.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Transparent</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">See how decisions are made.</p>
      </div>
      <div class="bg-[var(--color-card)] rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-xl text-[var(--color-primary)] mb-2">Trusted</h3>
        <p class="text-[var(--color-muted-foreground)] text-sm">Join a community you can trust.</p>
      </div>
    </div>
    <div class="mt-8">
      <span class="inline-block bg-[var(--color-primary)] text-[var(--color-primary-foreground)] text-sm font-medium px-4 py-2 rounded-full">
        Trusted by 10,000+ users
      </span>
    </div>
  </div>
</section>
<!-- Final CTA -->
<section class="py-16 bg-[var(--color-background)]">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="font-heading font-bold text-3xl text-[var(--color-primary)] mb-8">
      Ready to Make a Difference?
    </h2>
    <a href="#" class="px-8 py-4 rounded-full bg-[var(--color-primary)] text-[var(--color-primary-foreground)] font-medium hover:bg-[var(--color-secondary)] transition">
      Get Started
    </a>
  </div>
</section>
<!-- Footer -->
<footer class="bg-[var(--color-muted)] py-8">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="text-[var(--color-muted-foreground)] text-sm">
      © 2025 Nairobi Talks. All rights reserved.
    </p>
  </div>
</footer>
</div>