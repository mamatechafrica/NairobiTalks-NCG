<%= render partial: 'shared/header', locals: { title: (current_user.admin? ? "Admin Dashboard" : "My Dashboard") } %>
<!-- User Info Card -->
<div class="max-w-6xl mx-auto px-6 mb-8">
  <div class="bg-white border rounded-lg shadow-sm p-4">
    <div class="flex items-center gap-6">
      <div class="flex-shrink-0">
        <div class="bg-[var(--color-primary)] text-white rounded-full flex items-center justify-center w-20 h-20 text-2xl">
          <%= @user_data[:name].first.upcase %>
        </div>
      </div>
      <div class="flex-1">
        <h2 class="text-xl font-bold text-[var(--color-primary)] mb-1"><%= @user_data[:name] %></h2>
        <p class="text-gray-500 mb-3">Member since <%= @user_data[:join_date] %></p>
        <div class="flex gap-6">
          <div class="text-center">
            <div class="font-bold text-[var(--color-success)] text-lg"><%= @user_data[:total_ideas] %></div>
            <small class="text-gray-500">Ideas</small>
          </div>
          <div class="text-center">
            <div class="font-bold text-[var(--color-primary)] text-lg"><%= @user_data[:comments_count] %></div>
            <small class="text-gray-500">Comments</small>
          </div>
          <div class="text-center">
            <div class="font-bold text-yellow-500 text-lg"><%= @user_data[:community_score] %></div>
            <small class="text-gray-500">Score</small>
          </div>
        </div>
      </div>
      <div class="flex-shrink-0 text-right"></div>
    </div>
  </div>
</div> 
<!-- Removed duplicate My Ideas & Voted Ideas card/tab section. -->
<!-- My Ideas Section -->
<div class="max-w-6xl mx-auto px-6 mb-8">
  <div class="bg-white rounded-lg shadow-sm">
    <div class="flex items-center justify-between px-4 py-3 bg-[var(--color-primary)] text-white rounded-t-lg">
      <h2 class="mb-0 text-lg font-bold"><i class="bi bi-lightbulb mr-2" aria-hidden="true"></i> My Ideas &amp; Voted Ideas</h2>
      <details class="text-sm">
        <summary class="cursor-pointer text-white">Toggle</summary>
      </details>
    </div>
    <div class="p-4">
      <!-- Tabs converted to stacked sections for simplicity -->
      <section aria-labelledby="my-ideas-heading" class="mb-6">
        <h3 id="my-ideas-heading" class="text-lg font-semibold mb-4">My Ideas</h3>
        <% if @submitted_ideas.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @submitted_ideas.each do |idea| %>
              <div class="bg-white border rounded-lg shadow-sm p-4" aria-label="Idea card for <%= idea[:title] %>">
                <div class="flex items-start justify-between mb-2">
                  <h6 class="font-semibold text-gray-800 mb-1"><%= idea[:title] %></h6>
                  <span class="inline-block px-2 py-1 rounded text-white font-semibold <%= idea[:status] == 'active' ? 'bg-[var(--color-success)]' : idea[:status] == 'implemented' ? 'bg-[var(--color-primary)]' : 'bg-yellow-500' %>" aria-label="Status: <%= idea[:status].capitalize %>"><%= idea[:status].capitalize %></span>
                </div>
                <% if idea[:ward].present? %>
                  <p class="text-sm text-gray-700 mb-2" aria-label="Ward: <%= idea[:ward] %>">Ward: <%= idea[:ward] %></p>
                <% end %>
                <% if idea[:topics].any? %>
                  <div class="mb-3">
                    <% idea[:topics].each do |topic| %>
                      <span class="inline-block bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded mr-1" aria-label="Topic: <%= topic %>"><%= topic %></span>
                    <% end %>
                  </div>
                <% end %>
                <div class="mt-4">
                  <div class="flex justify-between items-center text-sm text-gray-700">
                    <span class="font-semibold text-[var(--color-success)]">👍 <%= idea[:upvotes] %></span>
                    <span class="font-semibold text-red-600">👎 <%= idea[:downvotes] %></span>
                    <span class="font-semibold text-[var(--color-primary)]">💬 <%= idea[:comments] %></span>
                  </div>
                  <small class="text-gray-500">Submitted: <%= idea[:submitted_date] %></small>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <i class="bi bi-lightbulb text-gray-400 text-3xl mb-3"></i>
            <h5 class="text-gray-700 mb-2">No ideas submitted yet</h5>
            <p class="text-gray-600 mb-4">Share your vision for improving our community!</p>
            <%= link_to "Submit Your First Idea", new_submission_path, class: "inline-block px-4 py-2 rounded bg-[var(--color-success)] text-white" %>
          </div>
        <% end %>
      </section>

      <section aria-labelledby="voted-ideas-heading">
        <h3 id="voted-ideas-heading" class="text-lg font-semibold mb-4">Voted Ideas</h3>
        <% if @voted_ideas.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @voted_ideas.each do |idea| %>
              <div class="bg-white rounded-lg shadow-sm p-4">
                <h3 class="font-bold text-[var(--color-primary)] mb-2"><%= idea.title %></h3>
                <div class="mb-2">
                  <% if idea.ward.present? %>
                    <span class="inline-block bg-gray-100 text-gray-700 px-2 py-1 rounded mr-1"><%= idea.ward %></span>
                  <% end %>
                  <% if idea.topic.present? %>
                    <span class="inline-block bg-[var(--color-primary)] text-white px-2 py-1 rounded"><%= idea.topic %></span>
                  <% end %>
                </div>
                <p class="text-gray-700 mb-3 min-h-[3em] text-base"><%= truncate(idea.description, length: 100) if idea.respond_to?(:description) %></p>
                <div class="flex justify-between items-center mt-auto">
                  <span class="text-gray-500 text-sm">👍 <%= idea.upvotes %> | 👎 <%= idea.downvotes %></span>
                  <span class="text-[var(--color-primary)] text-sm font-semibold">💬 <%= idea.comments.count if idea.respond_to?(:comments) %></span>
                  <%= link_to "View", community_idea_path(idea), class: "inline-block px-3 py-1 text-[var(--color-primary)] border border-[var(--color-primary)] rounded-sm text-sm" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <i class="bi bi-hand-thumbs-up text-[var(--color-primary)] text-3xl mb-3" aria-hidden="true"></i>
            <h5 class="text-gray-700 mb-2">You haven't voted for any ideas yet</h5>
            <p class="text-gray-600 mb-4">Explore and vote for ideas to see them here!</p>
            <%= link_to "Explore Ideas", community_ideas_path, class: "inline-block px-4 py-2 rounded bg-[var(--color-primary)] text-white" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
  <!-- User Recent Activity Section -->
  <div class="max-w-6xl mx-auto px-6 mb-8">
    <div class="bg-white rounded-lg shadow-sm mt-4">
      <div class="px-4 py-3 bg-[var(--color-success)] text-white rounded-t-lg">
        <h2 class="mb-0 text-lg font-bold"><i class="bi bi-clock-history mr-2" aria-hidden="true"></i> Recent Activity</h2>
      </div>
      <div class="p-4">
        <% if @recent_activities.present? %>
          <ul class="space-y-2">
            <% @recent_activities.each do |activity| %>
              <li class="border rounded px-3 py-2">
                <span class="font-semibold"><%= activity[:type].capitalize %></span>:
                <span class="ml-1"><%= activity[:description] %></span>
                <span class="text-gray-500 text-sm ml-2">- <%= activity[:date] %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="text-center py-6">
            <i class="bi bi-activity text-[var(--color-success)] text-3xl mb-3"></i>
            <h5 class="text-gray-700 mb-2">No recent activity</h5>
            <p class="text-gray-600 mb-0">Your latest comments, votes, and submissions will appear here.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div> 
  <!-- Community Stats Section (Refactored) -->
  <div class="max-w-6xl mx-auto px-6 mb-8">
    <div class="bg-white rounded-lg shadow-sm">
      <div class="flex items-center justify-between px-4 py-3 bg-[var(--color-success)] text-white rounded-t-lg">
        <h2 class="mb-0 text-lg font-bold"><i class="bi bi-bar-chart mr-2" aria-hidden="true"></i> Community Stats</h2>
        <details class="text-sm"><summary class="cursor-pointer text-white">Toggle</summary></details>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Participation Trend -->
          <div>
            <h6 class="font-semibold text-[var(--color-success)] mb-2">Participation Trend</h6>
            <div class="text-sm text-gray-700">
              <% @community_stats[:participation_trend].each do |month| %>
                <div class="flex justify-between mb-1">
                  <span><%= month[:month] %></span>
                  <span class="text-gray-500">Ideas: <%= month[:ideas] %>, Comments: <%= month[:comments] %></span>
                </div>
              <% end %>
            </div>
          </div>
          <!-- Ward Involvement -->
          <div>
            <h6 class="font-semibold text-[var(--color-success)] mb-2">Ward Involvement</h6>
            <div class="text-sm text-gray-700">
              <% @community_stats[:ward_involvement].first(5).each do |ward| %>
                <div class="flex justify-between mb-1">
                  <span><%= ward[:ward] %></span>
                  <span class="inline-block bg-[var(--color-primary)] text-white px-2 py-1 rounded"><%= ward[:count] %></span>
                </div>
              <% end %>
            </div>
          </div>
          <!-- Topic Preferences -->
          <div>
            <h6 class="font-semibold text-[var(--color-success)] mb-2">Topic Preferences</h6>
            <div class="text-sm text-gray-700">
              <% @community_stats[:topic_preferences].first(5).each do |topic| %>
                <div class="flex justify-between mb-1">
                  <span><%= topic[:topic] %></span>
                  <span class="inline-block bg-[var(--color-success)] text-white px-2 py-1 rounded"><%= topic[:count] %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
