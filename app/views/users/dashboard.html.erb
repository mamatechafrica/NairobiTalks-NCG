                      </div>
                      <small class="text-muted"><%= activity.created_at.strftime('%b %d, %Y') %></small>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">No recent activity on the platform.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
