<div class="bg-light min-vh-100">
  <header class="bg-white shadow-sm py-4">
    <div class="container">
      <div class="flex items-center">
        <div class="flex-1">
          <h1 class="h4 font-bold text-success mb-0">
            Edit Profile
          </h1>
        </div>
        <div class="ml-auto">
          <%= link_to "← Back to Profile", profile_path, class: "text-success font-medium no-underline" %>
        </div>
      </div>
    </div>
  </header>
  <main class="container py-5">
    <div class="flex justify-center">
      <div class="lg:w-2/3 w-full">
        <div class="bg-white border border-green-200 shadow-sm rounded-lg">
          <div class="p-4 md:p-5">
            <h2 class="h3 font-bold text-success mb-4">
              Update Your Information
            </h2>
            <form action="<%= user_path(@user) %>" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :_method, :patch %>
              <% if @user.errors.any? %>
                <div class="rounded-lg bg-red-100 border-l-4 border-red-600 text-red-800 p-4 mb-4">
                  <h5 class="font-semibold">Please fix the following errors:</h5>
                  <ul class="mt-2">
                    <% @user.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              <div class="mb-4">
                <label for="user_email" class="block font-semibold mb-1">Email Address</label>
                <input type="email" name="user[email]" id="user_email" class="block w-full rounded-md border-2 border-gray-200 px-3 py-3 text-lg focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:ring-opacity-20" value="<%= @user.email %>" required />
                <div class="form-text">
                  This is your login email address.
                </div>
              </div>
              <div class="flex justify-end gap-3">
                <%= link_to "Cancel", profile_path, class: "inline-block px-4 py-2 rounded border border-gray-300 text-gray-700" %>
                <button type="submit" class="inline-block px-4 py-2 rounded bg-[var(--color-primary)] text-white">Update Profile</button>
              </div>
            </form>
            <div class="mt-5 pt-4 border-t">
              <h3 class="h5 font-semibold text-dark mb-3">Password</h3>
              <p class="text-muted mb-3">
                Need to change your password?
              </p>
              <%= link_to "Change Password", edit_user_registration_path, class: "inline-block px-4 py-2 rounded border border-gray-300 text-gray-700" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
