<div class="bg-light min-vh-100">
  <header class="bg-white shadow-sm py-4">
    <div class="container">
      <div class="row align-items-center">
        <div class="col">
          <h1 class="h4 fw-bold text-success mb-0">
            Edit Profile
          </h1>
        </div>
        <div class="col-auto">
          <%= link_to "← Back to Profile", profile_path, class: "text-success fw-medium text-decoration-none" %>
        </div>
      </div>
    </div>
  </header>
  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-success shadow-sm">
          <div class="card-body p-4 p-md-5">
            <h2 class="card-title h3 fw-bold text-success mb-4">
              Update Your Information
            </h2>
            <form action="<%= user_path(@user) %>" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :_method, :patch %>
              <% if @user.errors.any? %>
                <div class="alert alert-danger mb-4">
                  <h5 class="alert-heading fw-bold">Please fix the following errors:</h5>
                  <ul class="mb-0">
                    <% @user.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              <div class="mb-4">
                <label for="user_email" class="form-label fw-semibold">Email Address</label>
                <input type="email" name="user[email]" id="user_email" class="form-control form-control-lg" value="<%= @user.email %>" required />
                <div class="form-text">
                  This is your login email address.
                </div>
              </div>
              <div class="d-flex justify-content-end gap-3">
                <%= link_to "Cancel", profile_path, class: "btn btn-outline-secondary" %>
                <button type="submit" class="btn btn-success">Update Profile</button>
              </div>
            </form>
            <div class="mt-5 pt-4 border-top">
              <h3 class="h5 fw-semibold text-dark mb-3">Password</h3>
              <p class="text-muted mb-3">
                Need to change your password?
              </p>
              <%= link_to "Change Password", edit_user_registration_path, class: "btn btn-secondary" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
