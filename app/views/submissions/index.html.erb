<div class="min-h-screen bg-base-100 py-8 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="mb-4">
      <%= render partial: 'shared/header', locals: { title: 'Idea Submissions' } %>
      <div class="flex flex-wrap gap-3 mt-3">
        <%= render 'admin/shared/button', href: data_export_ideas_path(format: :csv), variant: 'success' do %>Export Ideas<% end %>
        <%= render 'admin/shared/button', href: data_analytics_path, variant: 'primary', html_options: { target: '_blank' } do %>View Analytics<% end %>
      </div>
    </div>

    <div class="card bg-base-100 shadow mb-6">
      <div class="card-body">
        <form action="<%= submissions_path %>" method="get" class="grid grid-cols-1 md:grid-cols-3 gap-4" aria-label="Filter Submissions">
          <div>
            <label for="ward_filter" class="text-sm font-medium">Ward</label>
            <%= select_tag :ward, options_for_select(["All"] + WARD_LIST.map { |w| w[:name] }, params[:ward]), prompt: "Select Ward", class: "select select-bordered w-full", id: "ward_filter" %>
          </div>
          <div>
            <label for="topic_filter" class="text-sm font-medium">Topic</label>
            <%= select_tag :topic, options_for_select(["All", "Health", "Education", "Infrastructure", "Security", "Environment", "Economy", "Culture", "Sports"], params[:topic]), prompt: "Select Topic", class: "select select-bordered w-full", id: "topic_filter" %>
          </div>
          <div class="flex items-end">
            <%= render 'admin/shared/button', type: 'submit', variant: 'primary', extra_classes: 'w-full' do %>Filter<% end %>
          </div>
        </form>
      </div>
    </div>

    <div class="card bg-base-100 shadow">
      <div class="card-body p-0">
        <div class="px-4 py-3 border-b">
          <h5 class="text-lg font-semibold">Submitted Community Ideas</h5>
        </div>
        <div class="overflow-x-auto">
          <% if @submissions.any? %>
            <table class="table w-full">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Title</th>
                  <th>Description</th>
                  <th>Location</th>
                  <th>Topic</th>
                  <th>Other Topic</th>
                  <th>Anonymity</th>
                  <th>Contact</th>
                </tr>
              </thead>
              <tbody>
                <% @submissions.each do |row| %>
                  <tr>
                    <% row.each do |cell| %>
                      <td class="align-top"><%= cell %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="p-6 text-center text-sm text-gray-500">No submissions found.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>