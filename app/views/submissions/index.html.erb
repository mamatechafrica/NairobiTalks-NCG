<h1>Admin Dashboard – Idea Submissions</h1>
<div style="margin-bottom: 20px;">
  <%= link_to "Export Community Ideas to CSV", data_export_ideas_path, class: "btn btn-success" %>
  <%= link_to "View Analytics", data_analytics_path, class: "btn btn-primary", target: "_blank" %>
</div>
<%= form_with url: submissions_path, method: :get, local: true do %>
  <%= select_tag :ward, options_for_select(["All"] + WARD_LIST.map { |w| w[:name] }, params[:ward]), prompt: "Select Ward" %>
  <%= select_tag :topic, options_for_select(["All", "Health", "Education", "Infrastructure", "Security", "Environment", "Economy", "Culture", "Sports"], params[:topic]), prompt: "Select Topic" %>
  <%= submit_tag "Filter" %>
<% end %>
<table aria-label="Submitted Community Ideas">
  <thead>
    <tr>
      <th>Timestamp</th>
      <th>Title</th>
      <th>Description</th>
      <th>Location</th>
      <th>Topic</th>
      <th>Other Topic</th>
      <th>Anonymity</th>
      <th>Contact</th>
    </tr>
  </thead>
  <tbody>
    <% @submissions.each do |row| %>
      <tr>
        <% row.each do |cell| %>
          <td><%= cell %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>