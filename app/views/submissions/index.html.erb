<div class="bg-light min-vh-100 py-4">
  <div class="container">
    <div class="row mb-4">
      <div class="col-12">
        <div class="d-flex justify-content-between align-items-center bg-white p-4 rounded shadow-sm">
          <h1 class="h3 fw-bold text-success mb-0">Admin Dashboard – Idea Submissions</h1>
          <div class="d-flex gap-3">
            <%= link_to "Export Community Ideas to CSV", data_export_ideas_path, class: "btn btn-success" %>
            <%= link_to "View Analytics", data_analytics_path, class: "btn btn-primary", target: "_blank" %>
          </div>
        </div>
      </div>
    </div>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card border-success">
          <div class="card-body">
            <form action="<%= submissions_path %>" method="get" class="row g-3">
              <div class="col-md-4">
                <%= select_tag :ward, options_for_select(["All"] + WARD_LIST.map { |w| w[:name] }, params[:ward]), prompt: "Select Ward", class: "form-select" %>
              </div>
              <div class="col-md-4">
                <%= select_tag :topic, options_for_select(["All", "Health", "Education", "Infrastructure", "Security", "Environment", "Economy", "Culture", "Sports"], params[:topic]), prompt: "Select Topic", class: "form-select" %>
              </div>
              <div class="col-md-4">
                <%= submit_tag "Filter", class: "btn btn-success w-100" %>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <div class="card border-success">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0">Submitted Community Ideas</h5>
          </div>
          <div class="card-body p-0">
            <% if @submissions.any? %>
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th class="border-0">Timestamp</th>
                      <th class="border-0">Title</th>
                      <th class="border-0">Description</th>
                      <th class="border-0">Location</th>
                      <th class="border-0">Topic</th>
                      <th class="border-0">Other Topic</th>
                      <th class="border-0">Anonymity</th>
                      <th class="border-0">Contact</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @submissions.each do |row| %>
                      <tr>
                        <% row.each do |cell| %>
                          <td><%= cell %></td>
                        <% end %>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center py-5">
                <p class="text-muted mb-0">No submissions found.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>