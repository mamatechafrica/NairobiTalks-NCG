<div class="bg-[var(--color-background)] min-h-screen py-8">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-6">
      <%= render partial: 'shared/header', locals: { title: 'Admin Dashboard – Idea Submissions' } %>
      <div class="flex gap-3 mb-3">
        <%= link_to "Export Community Ideas to CSV", data_export_ideas_path, class: "inline-block px-4 py-2 rounded bg-[var(--color-success)] text-white" %>
        <%= link_to "View Analytics", data_analytics_path, class: "inline-block px-4 py-2 rounded bg-[var(--color-primary)] text-white", target: "_blank" %>
      </div>
    </div>

    <div class="mb-6">
      <div class="bg-white rounded-lg shadow-sm p-4 border-2 border-[var(--color-success)]">
        <form action="<%= submissions_path %>" method="get" class="grid grid-cols-1 md:grid-cols-3 gap-4" aria-label="Filter Submissions">
          <div>
            <label for="ward_filter" class="block text-sm font-medium">Ward</label>
            <%= select_tag :ward, options_for_select(["All"] + WARD_LIST.map { |w| w[:name] }, params[:ward]), prompt: "Select Ward", class: "mt-1 block w-full rounded border-gray-300 px-3 py-2", id: "ward_filter", aria_label: "Ward Filter" %>
          </div>
          <div>
            <label for="topic_filter" class="block text-sm font-medium">Topic</label>
            <%= select_tag :topic, options_for_select(["All", "Health", "Education", "Infrastructure", "Security", "Environment", "Economy", "Culture", "Sports"], params[:topic]), prompt: "Select Topic", class: "mt-1 block w-full rounded border-gray-300 px-3 py-2", id: "topic_filter", aria_label: "Topic Filter" %>
          </div>
          <div>
            <%= submit_tag "Filter", class: "bg-[var(--color-success)] text-white font-semibold w-full py-2 rounded", aria_label: "Apply Filter" %>
          </div>
        </form>
      </div>
    </div>

    <div>
      <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="bg-[var(--color-success)] text-white px-6 py-4">
          <h5 class="mb-0">Submitted Community Ideas</h5>
        </div>
        <div class="p-4">
          <% if @submissions.any? %>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Timestamp</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Title</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Description</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Location</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Topic</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Other Topic</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Anonymity</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Contact</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100">
                  <% @submissions.each do |row| %>
                    <tr>
                      <% row.each do |cell| %>
                        <td class="px-4 py-3 text-sm text-gray-700"><%= cell %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-12">
              <p class="text-gray-500 mb-0">No submissions found.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>