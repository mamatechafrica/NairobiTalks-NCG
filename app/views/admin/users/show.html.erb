<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <!-- User Header -->
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center">
            <div class="flex-shrink-0 h-16 w-16">
              <div class="h-16 w-16 rounded-full bg-gray-300 flex items-center justify-center">
                <span class="text-xl font-medium text-gray-700">
                  <%= @user.email.first.upcase %>
                </span>
              </div>
            </div>
            <div class="ml-6">
              <h1 class="text-2xl font-bold text-gray-900">
                <% if @user.username.present? %>
                  <span><%= @user.username %></span>
                <% end %>
                <span class="ml-2"><%= @user.email %></span>
                <% if @user.phone_number.present? %>
                  <span class="ml-2">Phone: <%= @user.phone_number %></span>
                <% end %>
              </h1>
              <h1 class="text-2xl font-bold text-gray-900">
                <div class="flex items-center mt-1">
                  <% if @user.admin? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Admin
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Citizen
                    </span>
                  <% end %>
                  <span class="ml-4 text-sm text-gray-500">
                    Member since <%= @user.created_at.strftime('%B %Y') %>
                  </span>
                </div>
              </div>
            </div>
            <div class="flex space-x-3">
              <%= link_to "Edit User", edit_admin_user_path(@user), class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700" %>
              <%= link_to "Edit User", edit_admin_user_path(@user), class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700", aria: { label: "Edit user #{@user.email}" } %>
              <% if @user != current_user %>
                <%= button_to "Toggle Admin", toggle_admin_admin_user_path(@user), method: :patch,
                  class: "bg-yellow-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-yellow-700",
                  data: { confirm: "Are you sure you want to #{ @user.admin? ? 'demote' : 'promote' } this user?" } %>
                <%= button_to "Delete User", admin_user_path(@user), method: :delete,
                  class: "bg-red-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-red-700",
                  data: { confirm: "Are you sure you want to delete this user? This action cannot be undone." } %>
                <%= button_to "Toggle Admin", toggle_admin_admin_user_path(@user), method: :patch,
                  class: "bg-yellow-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-yellow-700",
                  data: { confirm: "Are you sure you want to #{ @user.admin? ? 'demote' : 'promote' } this user?" },
                  aria: { label: "Toggle admin status for user #{@user.email}" } %>
                <%= button_to "Delete User", admin_user_path(@user), method: :delete,
                  class: "bg-red-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-red-700",
                  data: { confirm: "Are you sure you want to delete this user? This action cannot be undone." },
                  aria: { label: "Delete user #{@user.email}" } %>
              <% end %>
              <%= link_to "Back to Users", admin_users_path, class: "bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-gray-700" %>
              <%= link_to "Back to Users", admin_users_path, class: "bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-gray-700", aria: { label: "Back to users list" } %>
            </div>
          </div>
          <!-- Statistics Cards -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gray-50 rounded-lg p-6">
              <div class="flex items-center">
                <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                  💡
                </div>
                <div class="p-3 rounded-full bg-blue-100 text-blue-600" aria-hidden="true">
                  💡
                </div>
                <div class="ml-4">
                  <p class="text-sm font-medium text-gray-500">Ideas Submitted</p>
                  <p class="text-2xl font-bold text-gray-900"><%= @user_ideas.count %></p>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 rounded-lg p-6">
              <div class="flex items-center">
                <div class="p-3 rounded-full bg-green-100 text-green-600">
                  💬
                </div>
                <div class="p-3 rounded-full bg-green-100 text-green-600" aria-hidden="true">
                  💬
                </div>
                <div class="ml-4">
                  <p class="text-sm font-medium text-gray-500">Comments Made</p>
                  <p class="text-2xl font-bold text-gray-900"><%= @user_comments.count %></p>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 rounded-lg p-6">
              <div class="flex items-center">
                <div class="p-3 rounded-full bg-purple-100 text-purple-600">
                  👍
                </div>
                <div class="p-3 rounded-full bg-purple-100 text-purple-600" aria-hidden="true">
                  👍
                </div>
                <div class="ml-4">
                  <p class="text-sm font-medium text-gray-500">Votes Cast</p>
                  <p class="text-2xl font-bold text-gray-900"><%= @user.votes.count %></p>
                </div>
              </div>
            </div>
          </div>
          <!-- User's Ideas -->
          <% if @user_ideas.any? %>
            <div class="mb-8">
              <h2 class="text-lg font-medium text-gray-900 mb-4">Submitted Ideas</h2>
              <h2 class="text-lg font-medium text-gray-900 mb-4">Submitted Ideas</h2>
              <div class="space-y-4">
                <% @user_ideas.each do |idea| %>
                  <div class="bg-white border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
                    <div class="flex justify-between items-start">
                      <div class="flex-1">
                        <h3 class="text-sm font-medium text-gray-900">
                          <%= link_to idea.title, community_idea_path(idea), class: "hover:underline" %>
                        </h3>
                        <p class="text-sm text-gray-500 mt-1">
                          <%= idea.description.truncate(150) %>
                        </p>
                        <div class="flex items-center mt-2 text-xs text-gray-500">
                          <span><%= idea.created_at.strftime('%b %d, %Y') %></span>
                          <span class="mx-2">•</span>
                          <span><%= idea.comments.count %> comments</span>
                          <span class="mx-2">•</span>
                          <span><%= idea.upvotes_count - idea.downvotes_count %> votes</span>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
          <!-- User's Comments -->
          <% if @user_comments.any? %>
            <div>
              <h2 class="text-lg font-medium text-gray-900 mb-4">Recent Comments</h2>
              <div class="space-y-4">
                <% @user_comments.each do |comment| %>
                  <div class="bg-white border border-gray-200 rounded-lg p-4">
                    <div class="flex justify-between items-start mb-2">
                      <h3 class="text-sm font-medium text-gray-900">
                        On: <%= link_to comment.community_idea.title, community_idea_path(comment.community_idea), class: "hover:underline" %>
                      </h3>
                      <span class="text-xs text-gray-500">
                        <%= comment.created_at.strftime('%b %d, %Y') %>
                      </span>
                    </div>
                    <p class="text-sm text-gray-700">
                      <%= comment.body %>
                    </p>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if @user_ideas.empty? && @user_comments.empty? %>
            <div class="text-center py-12">
              <p class="text-gray-500">This user hasn't been active yet.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>