<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <h1 class="h4 mb-4">Admin Sign In</h1>
          <%= form_with url: user_session_path, local: true do %>
            <div class="mb-3">
              <%= label_tag 'user[email]', 'Email', class: 'form-label' %>
              <%= email_field_tag 'user[email]', nil, class: 'form-control' %>
            </div>
            <div class="mb-3">
              <%= label_tag 'user[password]', 'Password', class: 'form-label' %>
              <%= password_field_tag 'user[password]', nil, class: 'form-control' %>
            </div>
            <div class="mb-2">
              <%= hidden_field_tag 'user[remember_me]', '1' %>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <%= submit_tag 'Log in', class: 'btn btn-primary' %>
              <%= link_to 'Back', root_path, class: 'btn btn-link' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
