<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="rounded-b-lg overflow-hidden shadow-lg"
       style="background: linear-gradient(135deg, #024731 0%, #0C9F5E 50%, #F7B500 100%);">
    <div class="px-6 py-8 text-white">
      <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
        <div>
          <h1 class="text-3xl font-bold flex items-center gap-3">📄 <span><%= @planning_document.title %></span></h1>
          <div class="flex items-center gap-3 mt-3 flex-wrap">
            <span class="badge <%= @planning_document.document_type == 'CIDP' ? 'badge-primary' : 'badge-secondary' %>"><%= @planning_document.document_type %></span>
            <span class="badge <%= @planning_document.status == 'approved' ? 'badge-success' : 'badge-warning' %>"><%= @planning_document.status.titleize %></span>
            <span class="text-sm opacity-90"><%= "#{@planning_document.start_year} - #{@planning_document.end_year}" %></span>
          </div>
        </div>

        <div class="flex gap-3 flex-wrap">
          <%= render 'admin/shared/button', label: 'Edit', href: edit_admin_planning_document_path(@planning_document), variant: 'primary' %>
          <%= render 'admin/shared/button', label: 'Download', href: rails_blob_path(@planning_document.file, disposition: "attachment"), variant: 'success', html_options: { target: '_blank' } %>
          <%= render 'admin/shared/button', label: 'AI Summary', href: ai_summary_planning_document_path(@planning_document), variant: 'info' %>
          <%= render 'admin/shared/button', label: 'Delete', href: admin_planning_document_path(@planning_document), variant: 'error', html_options: { method: :delete, data: { confirm: 'Are you sure you want to delete this document?' } } %>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg mt-6 p-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-semibold text-emerald-800 mb-4">Document Details</h3>
        <dl class="grid grid-cols-1 gap-y-3">
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">Title:</dt>
            <dd><%= @planning_document.title %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">Type:</dt>
            <dd><%= @planning_document.document_type %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">Status:</dt>
            <dd><%= @planning_document.status.titleize %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">Year Range:</dt>
            <dd><%= "#{@planning_document.start_year} - #{@planning_document.end_year}" %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">File Name:</dt>
            <dd><%= @planning_document.file.filename %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">File Size:</dt>
            <dd><%= number_to_human_size(@planning_document.file.byte_size) %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">Uploaded:</dt>
            <dd><%= @planning_document.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-emerald-700">Last Updated:</dt>
            <dd><%= @planning_document.updated_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          </div>
        </dl>
      </div>

      <% if @planning_document.file.content_type == "application/pdf" %>
        <div>
          <h3 class="text-lg font-semibold text-emerald-800 mb-4">Document Preview</h3>
          <div class="border rounded-lg overflow-hidden bg-slate-50">
            <iframe src="<%= rails_blob_path(@planning_document.file) %>" width="100%" height="600" class="block">
              <p>Your browser does not support iframes. <a href="<%= rails_blob_path(@planning_document.file) %>" target="_blank">Click here to view the PDF</a></p>
            </iframe>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>