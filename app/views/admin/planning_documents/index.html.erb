<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="rounded-b-lg overflow-hidden shadow-lg"
       style="background: linear-gradient(135deg, #024731 0%, #0C9F5E 50%, #F7B500 100%);">
    <div class="px-6 py-8 text-white">
      <h1 class="text-3xl font-bold flex items-center gap-3">📄 Planning Documents Management</h1>
      <p class="mt-2 opacity-90">Manage CIDP and ADP documents for Nairobi County</p>
      <div class="mt-4">
        <%= render 'admin/shared/button', href: new_admin_planning_document_path, variant: 'primary', html_options: { aria: { label: 'Upload New Document' } } do %>
          ⬆️ Upload New Document
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg mt-6 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Year Range</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @planning_documents.each do |doc| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap font-semibold text-emerald-800 max-w-xs"><%= doc.title %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="badge <%= doc.document_type == 'CIDP' ? 'badge-primary' : 'badge-secondary' %>"><%= doc.document_type %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="badge <%= doc.status == 'approved' ? 'badge-success' : 'badge-warning' %>"><%= doc.status.titleize %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap"><%= "#{doc.start_year} - #{doc.end_year}" %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= doc.created_at.strftime("%b %d, %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= render 'admin/shared/button', href: admin_planning_document_path(doc), variant: 'outline', size: 'sm', extra_classes: 'mr-1', html_options: { aria: { label: 'View Document' } } do %>
                  👁️ View
                <% end %>
                <%= render 'admin/shared/button', href: edit_admin_planning_document_path(doc), variant: 'outline', size: 'sm', extra_classes: 'mr-1', html_options: { aria: { label: 'Edit Document' } } do %>
                  ✏️ Edit
                <% end %>
                <%= render 'admin/shared/button', href: admin_planning_document_path(doc), variant: 'error', size: 'sm', html_options: { method: :delete, data: { confirm: 'Are you sure?' }, aria: { label: 'Delete Document' } } do %>
                  🗑️ Delete
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @planning_documents.empty? %>
    <div class="mt-8">
      <div class="text-center py-12 px-4 sm:px-6 lg:px-8 bg-white rounded-lg shadow">
        <div class="text-4xl mb-4 text-gray-300">📄</div>
        <h3 class="text-lg font-medium text-emerald-800">No planning documents yet</h3>
        <p class="mt-2 text-sm text-gray-600">Get started by uploading your first CIDP or ADP document.</p>
          <div class="mt-4">
          <%= render 'admin/shared/button', href: new_admin_planning_document_path, variant: 'primary', html_options: { aria: { label: 'Upload First Document' } } do %>
            ⬆️ Upload First Document
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>