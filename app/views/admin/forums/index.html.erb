<main class="admin-forum" aria-label="Forum admin page">
  <header class="flex items-center justify-between mb-4 p-4 bg-white rounded shadow-sm">
    <div>
      <h1 class="mb-1 font-bold text-[#009339]">Forum Management</h1>
      <p class="text-sm text-gray-500 mb-0">Create, edit, and moderate forum topics and posts</p>
    </div>
    <div class="flex items-center gap-3">
    <%= render 'admin/shared/button', label: 'New Topic', href: new_admin_topic_path, variant: 'success', extra_classes: 'mr-3' %>
      <div class="flex items-center">
        <div class="rounded-full text-white mr-3 flex items-center justify-center font-bold" style="width:45px; height:45px; background-color: #3AA966;" aria-label="User initial">
          <%= current_user.email.first.upcase %>
        </div>
        <span class="text-gray-800 font-medium hidden lg:inline"><%= current_user.email %></span>
      </div>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <% if @topics.present? %>
        <div class="card bg-base-100 shadow">
          <div class="card-body p-0">
            <div class="overflow-x-auto">
              <table class="table w-full">
                <thead>
                  <tr class="bg-gray-50">
                    <th>Topic</th>
                    <th>Description</th>
                    <th>Posts</th>
                    <th>Created</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @topics.each do |topic| %>
                    <tr>
                      <td>
                        <h6 class="mb-1 font-medium"><%= topic.title %></h6>
                        <small class="text-sm text-gray-500"><%= truncate(topic.description, length: 100) %></small>
                      </td>
                      <td><%= topic.posts&.count || 0 %> posts</td>
                      <td><%= topic.created_at.strftime('%b %d, %Y') %></td>
                      <td class="text-nowrap">
                        <div class="flex gap-2 justify-end">
                            <%= render 'admin/shared/button', label: 'View', href: admin_topic_path(topic), variant: 'outline', size: 'sm', html_options: { title: 'View topic details' } %>
                            <%= render 'admin/shared/button', label: 'Edit', href: edit_admin_topic_path(topic), variant: 'outline', size: 'sm', html_options: { title: 'Edit topic' } %>
                            <%= button_to 'Delete', admin_topic_path(topic), method: :delete, 
                              class: 'btn btn-sm btn-error', 
                              form: { data: { confirm: "Are you sure you want to delete: topic '#{topic.title}'? This will also delete all associated posts." } },
                              title: 'Delete topic' %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card bg-base-100 shadow">
          <div class="card-body text-center py-10">
            <div class="text-gray-400 text-4xl mb-3">📭</div>
            <h5 class="text-lg font-semibold">No Topics Yet</h5>
            <p class="text-sm text-gray-500">Create your first forum topic to start community discussions.</p>
          </div>
        </div>
      <% end %>
    </div>

    <aside>
      <div class="card bg-base-100 shadow p-4">
        <h2 class="text-lg font-bold mb-3 text-[#3AA966]">Posts (Select a topic)</h2>
        <% if @selected_topic && @selected_topic.posts.any? %>
          <div class="divide-y">
            <% @selected_topic.posts.each do |post| %>
              <div class="py-2 flex items-center justify-between">
                <span class="text-sm"><%= truncate(post.body, length: 60) %></span>
                <span class="flex gap-2">
                  <%= render 'admin/shared/button', label: 'Edit', href: edit_admin_topic_post_path(@selected_topic, post), variant: 'outline', size: 'sm' %>
                  <%= render 'admin/shared/button', label: 'Delete', href: admin_topic_post_path(@selected_topic, post), variant: 'error', size: 'sm', html_options: { method: :delete, data: { confirm: 'Are you sure?' } } %>
                </span>
              </div>
            <% end %>
          </div>
          <%= render 'admin/shared/button', href: new_admin_topic_post_path(@selected_topic), variant: 'success', extra_classes: 'mt-3' do %>
            New Post
          <% end %>
        <% else %>
          <div class="p-3 rounded bg-info/10 text-sm text-gray-600">Select a topic to view its posts.</div>
        <% end %>
      </div>
    </aside>
  </div>
</main>
