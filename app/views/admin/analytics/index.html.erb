<div class="max-w-7xl mx-auto py-4 px-4 sm:px-6">
  <div class="mb-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold mb-1">📊 Community Ideas Analytics</h1>
        <p class="text-sm text-gray-500">Comprehensive analytics and insights for citizen engagement</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
    <div class="card bg-base-100 shadow h-full">
      <div class="card-body text-center p-4">
        <div class="mb-3 text-3xl">💡</div>
        <h3 class="mb-1 text-lg font-bold"><%= @total_ideas %></h3>
        <p class="mb-0 text-sm text-gray-500">Total Ideas</p>
      </div>
    </div>

    <div class="card bg-base-100 shadow h-full">
      <div class="card-body text-center p-4">
        <div class="mb-3 text-3xl">👍</div>
        <h3 class="mb-1 text-lg font-bold"><%= @total_upvotes %></h3>
        <p class="mb-0 text-sm text-gray-500">Total Upvotes</p>
      </div>
    </div>

    <div class="card bg-base-100 shadow h-full">
      <div class="card-body text-center p-4">
        <div class="mb-3 text-3xl">👎</div>
        <h3 class="mb-1 text-lg font-bold"><%= @total_downvotes %></h3>
        <p class="mb-0 text-sm text-gray-500">Total Downvotes</p>
      </div>
    </div>

    <div class="card bg-base-100 shadow h-full">
      <div class="card-body text-center p-4">
        <div class="mb-3 text-3xl">📈</div>
        <h3 class="mb-1 text-lg font-bold"><%= @avg_upvotes %></h3>
        <p class="mb-0 text-sm text-gray-500">Avg Upvotes/Idea</p>
      </div>
    </div>
  </div>

  <div class="card shadow mb-4">
    <div class="card-body p-0">
      <h2 class="px-4 py-3 text-lg font-semibold">🏆 Top 10 Ideas by Popularity</h2>
      <div class="overflow-x-auto">
        <table class="table w-full">
          <thead>
            <tr class="bg-gray-50">
              <th>Rank</th>
              <th>Title</th>
              <th>Ward</th>
              <th>Topic</th>
              <th>Upvotes</th>
              <th>Downvotes</th>
              <th>Score</th>
            </tr>
          </thead>
          <tbody>
            <% @top_ideas.each_with_index do |idea, index| %>
              <tr>
                <td>
                  <% if index < 3 %>
                    🏆
                  <% end %>
                  <%= index + 1 %>
                </td>
                <td class="font-semibold"><%= idea.title %></td>
                <td><span class="badge"><%= idea.ward %></span></td>
                <td><span class="badge badge-primary"><%= idea.topic %></span></td>
                <td><span class="text-success font-bold"><%= idea.upvotes %></span></td>
                <td><span class="text-error font-bold"><%= idea.downvotes %></span></td>
                <td><span class="font-bold <%= idea.upvotes - idea.downvotes >= 0 ? 'text-success' : 'text-error' %>"><%= idea.upvotes - idea.downvotes %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="card shadow h-full">
      <div class="card-body">
        <h3 class="text-sm font-semibold mb-3">📍 Ideas by Ward</h3>
        <% if @ward_counts.any? %>
          <% @ward_counts.each do |ward, count| %>
            <div class="flex items-center justify-between mb-2">
              <span class="font-medium"><%= ward %></span>
              <div class="flex items-center gap-2">
                <div class="w-24 bg-gray-200 rounded overflow-hidden">
                  <div class="bg-info h-2" style="width: <%= (@ward_counts.values.max > 0) ? (count.to_f / @ward_counts.values.max * 100).round : 0 %>%"></div>
                </div>
                <span class="badge"><%= count %></span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-4">
            <div class="text-3xl text-gray-400">📍</div>
            <p class="text-gray-500 mt-2">No ward data available</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card shadow h-full">
      <div class="card-body">
        <h3 class="text-sm font-semibold mb-3">🔖 Ideas by Topic</h3>
        <% if @topic_counts.any? %>
          <% @topic_counts.each do |topic, count| %>
            <div class="flex items-center justify-between mb-2">
              <span class="font-medium"><%= topic %></span>
              <div class="flex items-center gap-2">
                <div class="w-24 bg-gray-200 rounded overflow-hidden">
                  <div class="bg-success h-2" style="width: <%= (@topic_counts.values.max > 0) ? (count.to_f / @topic_counts.values.max * 100).round : 0 %>%"></div>
                </div>
                <span class="badge"><%= count %></span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-4">
            <div class="text-3xl text-gray-400">🔖</div>
            <p class="text-gray-500 mt-2">No topic data available</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>