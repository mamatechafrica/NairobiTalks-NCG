<div class="container py-4">
  <div class="mb-4">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-2">
      <div>
        <h1 class="text-xl md:text-2xl font-bold mb-1"><i class="bi bi-bar-chart-fill mr-2" aria-hidden="true"></i> Community Ideas Analytics</h1>
        <p class="mb-0 text-gray-500">Comprehensive analytics and insights for citizen engagement</p>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
    <div class="h-full">
      <div class="bg-white shadow-sm rounded-lg h-full">
        <div class="p-4 text-center">
          <div class="mb-3">
            <i class="bi bi-lightbulb-fill text-warning text-[2.5rem]" aria-hidden="true"></i>
          </div>
          <h3 class="mb-1 text-dark font-bold"><%= @total_ideas %></h3>
          <p class="mb-0 text-gray-500">Total Ideas</p>
        </div>
      </div>
    </div>
    <div class="h-full">
      <div class="bg-white shadow-sm rounded-lg h-full">
        <div class="p-4 text-center">
          <div class="mb-3">
            <i class="bi bi-hand-thumbs-up-fill text-success text-[2.5rem]" aria-hidden="true"></i>
          </div>
          <h3 class="mb-1 text-dark font-bold"><%= @total_upvotes %></h3>
          <p class="mb-0 text-gray-500">Total Upvotes</p>
        </div>
      </div>
    </div>
    <div class="h-full">
      <div class="bg-white shadow-sm rounded-lg h-full">
        <div class="p-4 text-center">
          <div class="mb-3">
            <i class="bi bi-hand-thumbs-down-fill text-danger text-[2.5rem]" aria-hidden="true"></i>
          </div>
          <h3 class="mb-1 text-dark font-bold"><%= @total_downvotes %></h3>
          <p class="mb-0 text-gray-500">Total Downvotes</p>
        </div>
      </div>
    </div>
    <div class="h-full">
      <div class="bg-white shadow-sm rounded-lg h-full">
        <div class="p-4 text-center">
          <div class="stat-icon mb-3">
            <i class="bi bi-graph-up text-primary text-[2.5rem]" aria-hidden="true"></i>
          </div>
          <h3 class="mb-1 text-dark font-bold"><%= @avg_upvotes %></h3>
          <p class="mb-0 text-gray-500">Avg Upvotes/Idea</p>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-white shadow-sm rounded-lg mb-4">
    <div class="px-4 py-3 border-b bg-gray-50">
      <h2 class="text-lg font-semibold mb-0"><i class="bi bi-trophy-fill text-warning mr-2" aria-hidden="true"></i> Top 10 Ideas by Popularity</h2>
    </div>
    <div class="p-0">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left" scope="col">Rank</th>
              <th class="px-4 py-2 text-left" scope="col">Title</th>
              <th class="px-4 py-2 text-left" scope="col">Ward</th>
              <th class="px-4 py-2 text-left" scope="col">Topic</th>
              <th class="px-4 py-2 text-left" scope="col">Upvotes</th>
              <th class="px-4 py-2 text-left" scope="col">Downvotes</th>
              <th class="px-4 py-2 text-left" scope="col">Score</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y">
            <% @top_ideas.each_with_index do |idea, index| %>
              <tr>
                <td class="px-4 py-3">
                  <% if index < 3 %>
                    <i class="bi bi-trophy-fill text-warning mr-1" aria-hidden="true"></i>
                  <% end %>
                  <%= index + 1 %>
                </td>
                <td class="px-4 py-3 font-semibold"><%= idea.title %></td>
                <td class="px-4 py-3"><span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-200 text-gray-800 text-sm"><%= idea.ward %></span></td>
                <td class="px-4 py-3"><span class="inline-flex items-center px-2 py-0.5 rounded-full bg-[var(--color-primary)] text-white text-sm"><%= idea.topic %></span></td>
                <td class="px-4 py-3"><span class="text-[var(--color-success)] font-bold"><%= idea.upvotes %></span></td>
                <td class="px-4 py-3"><span class="text-red-600 font-bold"><%= idea.downvotes %></span></td>
                <td class="px-4 py-3"><span class="font-bold <%= idea.upvotes - idea.downvotes >= 0 ? 'text-[var(--color-success)]' : 'text-red-600' %>"><%= idea.upvotes - idea.downvotes %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div>
      <div class="bg-white shadow-sm rounded-lg h-full">
        <div class="px-4 py-3 border-b bg-gray-50">
          <h3 class="text-sm font-semibold mb-0"><i class="bi bi-geo-alt-fill text-info mr-2" aria-hidden="true"></i> Ideas by Ward</h3>
        </div>
        <div class="p-4">
          <% if @ward_counts.any? %>
            <% @ward_counts.each do |ward, count| %>
              <div class="flex items-center justify-between mb-2">
                <span class="font-medium"><%= ward %></span>
                <div class="flex items-center">
                  <div class="w-24 h-2 bg-gray-200 rounded mr-2">
                    <div class="h-2 bg-sky-500 rounded" style="width: <%= (@ward_counts.values.max > 0) ? (count.to_f / @ward_counts.values.max * 100).round : 0 %>%"></div>
                  </div>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-sky-100 text-sky-700 text-sm"><%= count %></span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <i class="bi bi-geo-alt text-gray-400 text-[3rem]" aria-hidden="true"></i>
              <p class="text-gray-500 mt-2">No ward data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div>
      <div class="bg-white shadow-sm rounded-lg h-full">
        <div class="px-4 py-3 border-b bg-gray-50">
          <h3 class="text-sm font-semibold mb-0"><i class="bi bi-tag-fill text-success mr-2"></i> Ideas by Topic</h3>
        </div>
        <div class="p-4">
          <% if @topic_counts.any? %>
            <% @topic_counts.each do |topic, count| %>
              <div class="flex items-center justify-between mb-2">
                <span class="font-medium"><%= topic %></span>
                <div class="flex items-center">
                  <div class="w-24 h-2 bg-gray-200 rounded mr-2">
                    <div class="h-2 bg-[var(--color-success)] rounded" style="width: <%= (@topic_counts.values.max > 0) ? (count.to_f / @topic_counts.values.max * 100).round : 0 %>%"></div>
                  </div>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-sm"><%= count %></span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <i class="bi bi-tag text-gray-400 text-[3rem]"></i>
              <p class="text-gray-500 mt-2">No topic data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
</div>