<div class="admin-analytics">
  <div class="page-header">
    <h1><i class="bi bi-bar-chart-fill me-2"></i> Community Ideas Analytics Dashboard</h1>
    <p>Comprehensive analytics and insights for citizen engagement</p>
  </div>
  <div class="analytics-content">
    <div class="analytics-grid row g-4 mb-5">
      <div class="col-md-3 col-6">
        <div class="card stat-card bg-white border-0 shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="stat-icon mb-3">
              <i class="bi bi-lightbulb-fill text-warning" style="font-size: 2.5rem;"></i>
            </div>
            <h3 class="mb-1 text-dark fw-bold"><%= @total_ideas %></h3>
            <p class="mb-0 text-muted">Total Ideas</p>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="card stat-card bg-white border-0 shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="stat-icon mb-3">
              <i class="bi bi-hand-thumbs-up-fill text-success" style="font-size: 2.5rem;"></i>
            </div>
            <h3 class="mb-1 text-dark fw-bold"><%= @total_upvotes %></h3>
            <p class="mb-0 text-muted">Total Upvotes</p>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="card stat-card bg-white border-0 shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="stat-icon mb-3">
              <i class="bi bi-hand-thumbs-down-fill text-danger" style="font-size: 2.5rem;"></i>
            </div>
            <h3 class="mb-1 text-dark fw-bold"><%= @total_downvotes %></h3>
            <p class="mb-0 text-muted">Total Downvotes</p>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="card stat-card bg-white border-0 shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="stat-icon mb-3">
              <i class="bi bi-graph-up text-primary" style="font-size: 2.5rem;"></i>
            </div>
            <h3 class="mb-1 text-dark fw-bold"><%= @avg_upvotes %></h3>
            <p class="mb-0 text-muted">Avg Upvotes/Idea</p>
          </div>
        </div>
      </div>
    </div>
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-light">
        <h2 class="h5 mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i> Top 10 Ideas by Popularity</h2>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th class="border-0">Rank</th>
                <th class="border-0">Title</th>
                <th class="border-0">Ward</th>
                <th class="border-0">Topic</th>
                <th class="border-0">Upvotes</th>
                <th class="border-0">Downvotes</th>
                <th class="border-0">Score</th>
              </tr>
            </thead>
            <tbody>
              <% @top_ideas.each_with_index do |idea, index| %>
                <tr>
                  <td>
                    <% if index < 3 %>
                      <i class="bi bi-trophy-fill text-warning me-1"></i>
                    <% end %>
                    <%= index + 1 %>
                  </td>
                  <td class="fw-semibold"><%= idea.title %></td>
                  <td><span class="badge bg-secondary rounded-pill"><%= idea.ward %></span></td>
                  <td><span class="badge bg-primary rounded-pill"><%= idea.topic %></span></td>
                  <td><span class="text-success fw-bold"><%= idea.upvotes %></span></td>
                  <td><span class="text-danger fw-bold"><%= idea.downvotes %></span></td>
                  <td><span class="fw-bold <%= idea.upvotes - idea.downvotes >= 0 ? 'text-success' : 'text-danger' %>"><%= idea.upvotes - idea.downvotes %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-light">
            <h3 class="h6 mb-0"><i class="bi bi-geo-alt-fill text-info me-2"></i> Ideas by Ward</h3>
          </div>
          <div class="card-body">
            <% if @ward_counts.any? %>
              <% @ward_counts.each do |ward, count| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fw-medium"><%= ward %></span>
                  <div class="d-flex align-items-center">
                    <div class="progress flex-grow-1 me-2" style="height: 8px; width: 100px;">
                      <div class="progress-bar bg-info" role="progressbar" style="width: <%= (@ward_counts.values.max > 0) ? (count.to_f / @ward_counts.values.max * 100).round : 0 %>%"></div>
                    </div>
                    <span class="badge bg-info rounded-pill"><%= count %></span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-4">
                <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">No ward data available</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-light">
            <h3 class="h6 mb-0"><i class="bi bi-tag-fill text-success me-2"></i> Ideas by Topic</h3>
          </div>
          <div class="card-body">
            <% if @topic_counts.any? %>
              <% @topic_counts.each do |topic, count| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fw-medium"><%= topic %></span>
                  <div class="d-flex align-items-center">
                    <div class="progress flex-grow-1 me-2" style="height: 8px; width: 100px;">
                      <div class="progress-bar bg-success" role="progressbar" style="width: <%= (@topic_counts.values.max > 0) ? (count.to_f / @topic_counts.values.max * 100).round : 0 %>%"></div>
                    </div>
                    <span class="badge bg-success rounded-pill"><%= count %></span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-4">
                <i class="bi bi-tag text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">No topic data available</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>