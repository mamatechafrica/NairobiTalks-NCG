<div class="container-fluid py-4">
  <div class="flex flex-col md:flex-row justify-between items-start gap-3 mb-3">
    <div>
      <h1 class="mb-1">Community Ideas Overview</h1>
      <p class="text-muted mb-0">Review and manage all submitted ideas, filter by ward/topic/status, and take action without leaving the admin console.</p>
    </div>
    <div>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-[var(--color-primary)] text-white text-sm">Total ideas: <%= @total_count %></span>
    </div>
  </div>
  <%= form_with url: admin_community_ideas_path, method: :get, local: false, data: { turbo_frame: "admin-community-ideas-table" }, class: "grid grid-cols-1 md:grid-cols-4 gap-3 items-end", aria: { label: "Filter Community Ideas" } do |form| %>
    <div>
      <%= form.label :status, "Status", class: "block font-semibold mb-1", aria: { label: "Status Filter" } %>
      <%= form.select :status, options_for_select([["All", ""]] + @statuses.map { |key, label| [label, key.to_s] }, @filters[:status]), { }, class: "block w-full rounded-md border-2 border-gray-200 px-3 py-2 bg-white focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:ring-opacity-20", aria: { label: "Status" } %>
    </div>
    <div>
      <%= form.label :ward, "Ward", class: "block font-semibold mb-1", aria: { label: "Ward Filter" } %>
      <%= form.select :ward, options_for_select([["All", ""]] + @wards.map { |ward| [ward, ward] }, @filters[:ward]), { }, class: "block w-full rounded-md border-2 border-gray-200 px-3 py-2 bg-white focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:ring-opacity-20", aria: { label: "Ward" } %>
    </div>
    <div>
      <%= form.label :topic, "Topic", class: "block font-semibold mb-1", aria: { label: "Topic Filter" } %>
      <%= form.select :topic, options_for_select([["All", ""]] + @topics.map { |topic| [topic, topic] }, @filters[:topic]), { }, class: "block w-full rounded-md border-2 border-gray-200 px-3 py-2 bg-white focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:ring-opacity-20", aria: { label: "Topic" } %>
    </div>
    <div>
      <%= form.label :search, "Search", class: "block font-semibold mb-1", aria: { label: "Search Filter" } %>
      <%= form.text_field :search, value: @filters[:search], class: "block w-full rounded-md border-2 border-gray-200 px-3 py-2 focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:ring-opacity-20", placeholder: "Search title or description...", aria: { label: "Search" } %>
    </div>
    <div class="flex gap-2">
      <%= form.submit "Apply filters", class: "inline-block w-full px-4 py-2 rounded bg-[var(--color-primary)] text-white", aria: { label: "Apply Filters" } %>
      <%= link_to "Reset", admin_community_ideas_path, class: "inline-block w-full py-2 rounded border border-gray-300 text-gray-700", aria: { label: "Reset Filters" } %>
    </div>
  <% end %>
  <turbo-frame id="admin-community-ideas-table">
    <div class="bg-white shadow-sm rounded">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left" scope="col">ID</th>
              <th class="px-4 py-2 text-left" scope="col">Title</th>
              <th class="px-4 py-2 text-left" scope="col">Description</th>
              <th class="px-4 py-2 text-left" scope="col">Topic</th>
              <th class="px-4 py-2 text-left" scope="col">Ward</th>
              <th class="px-4 py-2 text-left" scope="col">Upvotes</th>
              <th class="px-4 py-2 text-left" scope="col">Downvotes</th>
              <th class="px-4 py-2 text-left" scope="col">Net score</th>
              <th class="px-4 py-2 text-left" scope="col">Status</th>
              <th class="px-4 py-2 text-left" scope="col">Created at</th>
              <th class="px-4 py-2 text-left" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y">
            <% if @community_ideas.any? %>
              <% @community_ideas.each do |idea| %>
                <tr id="idea-<%= idea.id %>">
                  <td class="px-4 py-3"><%= idea.id %></td>
                  <td class="px-4 py-3"><strong><%= idea.title %></strong></td>
                  <td class="px-4 py-3"><%= truncate(idea.description, length: 100) %></td>
                  <td class="px-4 py-3"><%= idea.topic.presence || "—" %></td>
                  <td class="px-4 py-3"><%= idea.ward.presence || "—" %></td>
                  <td class="px-4 py-3"><%= idea.upvotes %></td>
                  <td class="px-4 py-3"><%= idea.downvotes %></td>
                  <td class="px-4 py-3"><%= idea.net_score %></td>
                  <td class="px-4 py-3"><%= community_idea_status_badge(idea) %></td>
                  <td class="px-4 py-3"><%= idea.created_at.strftime("%b %d, %Y") %></td>
                  <td class="px-4 py-3">
                    <div class="flex gap-2" role="group">
                      <%= link_to "View", admin_community_idea_path(idea), class: "inline-block px-3 py-1 rounded border border-[var(--color-primary)] text-[var(--color-primary)] text-sm" %>
                      <%= button_to approve_admin_community_idea_path(idea), method: :patch, class: "inline-block px-3 py-1 rounded bg-[var(--color-success)] text-white text-sm", form: { data: { turbo_confirm: "Approve this idea?" } } do %>
                        Approve
                      <% end %>
                      <%= button_to reject_admin_community_idea_path(idea), method: :patch, class: "inline-block px-3 py-1 rounded border border-red-600 text-red-600 text-sm", form: { data: { turbo_confirm: "Reject this idea?" } } do %>
                        Reject
                      <% end %>
                    </div>
                    <%= link_to "Add feedback", admin_community_idea_path(idea, anchor: "feedback"), class: "block mt-1 text-decoration-none text-gray-600" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="11" class="text-center py-4 text-gray-500">No community ideas match the filters.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% total_pages = [@total_pages, 1].max %>
      <% prev_page = [@page - 1, 1].max %>
      <% next_page = [@page + 1, total_pages].min %>
      <div class="flex flex-col sm:flex-row justify-between items-center gap-2 px-3 py-2 border-t">
        <small class="text-muted">Page <%= @page %> of <%= total_pages %></small>
        <nav aria-label="Community ideas pagination">
          <ul class="pagination mb-0">
            <li class="page-item <%= "disabled" if @page <= 1 %>">
              <%= link_to "Previous", admin_community_ideas_path(request.query_parameters.merge(page: prev_page)), class: "page-link" %>
            </li>
            <% 1.upto(total_pages) do |page_number| %>
              <li class="page-item <%= "active" if page_number == @page %>">
                <%= link_to page_number, admin_community_ideas_path(request.query_parameters.merge(page: page_number)), class: "page-link" %>
              </li>
            <% end %>
            <li class="page-item <%= "disabled" if @page >= total_pages %>">
              <%= link_to "Next", admin_community_ideas_path(request.query_parameters.merge(page: next_page)), class: "page-link" %>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </turbo-frame>
</div>
