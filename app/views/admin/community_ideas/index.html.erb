<div class="max-w-7xl mx-auto py-4 px-4 sm:px-6">
  <div class="flex flex-col md:flex-row justify-between items-start gap-3 mb-3">
    <div>
      <h1 class="text-xl font-semibold mb-1">Community Ideas Overview</h1>
      <p class="text-sm text-gray-500 mb-0">Review and manage all submitted ideas, filter by ward/topic/status, and take action without leaving the admin console.</p>
    </div>
    <div>
      <span class="badge badge-primary">Total ideas: <%= @total_count %></span>
    </div>
  </div>

  <%= form_with url: admin_community_ideas_path, method: :get, local: false, data: { turbo_frame: "admin-community-ideas-table" }, class: "grid grid-cols-1 md:grid-cols-4 gap-3 mb-4", aria: { label: "Filter Community Ideas" } do |form| %>
    <div>
      <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700", aria: { label: "Status Filter" } %>
      <%= form.select :status, options_for_select([["All", ""]] + @statuses.map { |key, label| [label, key.to_s] }, @filters[:status]), { }, class: "select select-bordered w-full mt-1", aria: { label: "Status" } %>
    </div>
    <div>
      <%= form.label :ward, "Ward", class: "block text-sm font-medium text-gray-700", aria: { label: "Ward Filter" } %>
      <%= form.select :ward, options_for_select([["All", ""]] + @wards.map { |ward| [ward, ward] }, @filters[:ward]), { }, class: "select select-bordered w-full mt-1", aria: { label: "Ward" } %>
    </div>
    <div>
      <%= form.label :topic, "Topic", class: "block text-sm font-medium text-gray-700", aria: { label: "Topic Filter" } %>
      <%= form.select :topic, options_for_select([["All", ""]] + @topics.map { |topic| [topic, topic] }, @filters[:topic]), { }, class: "select select-bordered w-full mt-1", aria: { label: "Topic" } %>
    </div>
    <div>
      <%= form.label :search, "Search", class: "block text-sm font-medium text-gray-700", aria: { label: "Search Filter" } %>
      <%= form.text_field :search, value: @filters[:search], class: "input input-bordered w-full mt-1", placeholder: "Search title or description...", aria: { label: "Search" } %>
    </div>
    <div class="md:col-span-4 flex gap-2">
      <%= render 'admin/shared/button', type: 'submit', variant: 'primary' do %>
        Apply filters
      <% end %>
      <%= render 'admin/shared/button', href: admin_community_ideas_path, variant: 'outline', html_options: { aria: { label: 'Reset Filters' } } do %>
        Reset
      <% end %>
    </div>
  <% end %>

  <turbo-frame id="admin-community-ideas-table">
    <div class="bg-white shadow rounded-lg">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Topic</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ward</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Upvotes</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Downvotes</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Net score</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created at</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if @community_ideas.any? %>
              <% @community_ideas.each do |idea| %>
                <tr id="idea-<%= idea.id %>">
                  <td class="px-4 py-3"><%= idea.id %></td>
                  <td class="px-4 py-3 font-semibold"><%= idea.title %></td>
                  <td class="px-4 py-3"><%= truncate(idea.description, length: 100) %></td>
                  <td class="px-4 py-3"><%= idea.topic.presence || "—" %></td>
                  <td class="px-4 py-3"><%= idea.ward.presence || "—" %></td>
                  <td class="px-4 py-3"><%= idea.upvotes %></td>
                  <td class="px-4 py-3"><%= idea.downvotes %></td>
                  <td class="px-4 py-3"><%= idea.net_score %></td>
                  <td class="px-4 py-3"><%= community_idea_status_badge(idea) %></td>
                  <td class="px-4 py-3"><%= idea.created_at.strftime("%b %d, %Y") %></td>
                  <td class="px-4 py-3 text-right whitespace-nowrap">
                    <div class="flex gap-2 justify-end">
                      <%= render 'admin/shared/button', href: admin_community_idea_path(idea), variant: 'outline', size: 'sm' do %>
                        View
                      <% end %>
                      <%= button_to approve_admin_community_idea_path(idea), method: :patch, class: "btn btn-sm btn-success", form: { data: { turbo_confirm: "Approve this idea?" } } do %>
                        Approve
                      <% end %>
                      <%= button_to reject_admin_community_idea_path(idea), method: :patch, class: "btn btn-sm btn-outline btn-error", form: { data: { turbo_confirm: "Reject this idea?" } } do %>
                        Reject
                      <% end %>
                    </div>
                    <%= link_to "Add feedback", admin_community_idea_path(idea, anchor: "feedback"), class: "block mt-1 text-sm text-emerald-600" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="11" class="px-4 py-8 text-center text-sm text-gray-500">No community ideas match the filters.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% total_pages = [@total_pages, 1].max %>
      <% prev_page = [@page - 1, 1].max %>
      <% next_page = [@page + 1, total_pages].min %>
      <div class="flex flex-col sm:flex-row justify-between items-center gap-2 px-3 py-2 border-t">
        <small class="text-sm text-gray-500">Page <%= @page %> of <%= total_pages %></small>
        <nav aria-label="Community ideas pagination">
            <div class="inline-flex items-center gap-2">
            <%= render 'admin/shared/button', href: admin_community_ideas_path(request.query_parameters.merge(page: prev_page)), size: 'sm' do %>Previous<% end %>
            <% 1.upto(total_pages) do |page_number| %>
              <%= render 'admin/shared/button', href: admin_community_ideas_path(request.query_parameters.merge(page: page_number)), size: 'sm', extra_classes: (page_number == @page ? 'btn-active' : nil) do %>
                <%= page_number %>
              <% end %>
            <% end %>
            <%= render 'admin/shared/button', href: admin_community_ideas_path(request.query_parameters.merge(page: next_page)), size: 'sm' do %>Next<% end %>
          </div>
        </nav>
      </div>
    </div>
  </turbo-frame>
</div>
