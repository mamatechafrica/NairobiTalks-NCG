<div class="container-fluid py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-3">
    <div>
      <h1 class="h4 mb-1"><%= @idea.title %></h1>
      <p class="mb-0 text-muted"><%= @idea.description %></p>
    </div>
    <div class="text-end">
      <span class="badge bg-light text-dark">ID: <%= @idea.id %></span>
      <br>
      <span class="badge bg-secondary mt-1"><%= @idea.created_at.strftime("%b %d, %Y %I:%M %p") %></span>
    </div>
  </div>
  <div class="row g-4">
    <div class="col-xl-8">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
            <div class="d-flex gap-3 align-items-center">
              <span><strong>Ward:</strong> <%= @idea.ward %></span>
              <span><strong>Topic:</strong> <%= @idea.topic %></span>
            </div>
            <div>
              <%= community_idea_status_badge(@idea) %>
            </div>
          </div>
          <div class="row text-center">
            <div class="col">
              <h6 class="text-muted mb-1">Upvotes</h6>
              <p class="h5 mb-0"><%= @idea.upvotes %></p>
            </div>
            <div class="col">
              <h6 class="text-muted mb-1">Downvotes</h6>
              <p class="h5 mb-0"><%= @idea.downvotes %></p>
            </div>
            <div class="col">
              <h6 class="text-muted mb-1">Net score</h6>
              <p class="h5 mb-0"><%= @idea.net_score %></p>
            </div>
          </div>
          <div class="d-flex gap-2 mt-3">
            <%= button_to approve_admin_community_idea_path(@idea), method: :patch, class: "btn btn-success", form: { data: { turbo_confirm: "Approve this idea?" } } do %>
              <i class="bi bi-check-circle me-1"></i> Approve
            <% end %>
            <%= button_to reject_admin_community_idea_path(@idea), method: :patch, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Reject this idea?" } } do %>
              <i class="bi bi-x-circle me-1"></i> Reject
            <% end %>
          </div>
        </div>
      </div>
      <div class="card shadow-sm border-0 mt-4" id="feedback">
        <div class="card-body">
          <h2 class="h6 mb-3">Admin feedback</h2>
          <%= form_with model: @idea, url: admin_community_idea_path(@idea), method: :patch do |form| %>
            <div class="mb-3">
              <%= form.label :admin_comment, "Share next steps or contextual notes" %>
              <%= form.text_area :admin_comment, class: "form-control", rows: 4 %>
            </div>
            <%= form.submit "Save feedback", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-xl-4">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <p class="text-muted mb-1"><strong>Description</strong></p>
          <p><%= @idea.description %></p>
          <hr>
          <p class="text-muted mb-1"><strong>Admin notes</strong></p>
          <p class="text-break"><%= @idea.admin_comment.presence || "No notes yet." %></p>
          <hr>
          <%= link_to "Back to overview", admin_community_ideas_path, class: "btn btn-outline-secondary w-100" %>
        </div>
      </div>
    </div>
  </div>
</div>
