<div class="container-fluid py-4">
    <div class="flex flex-col md:flex-row justify-between items-start gap-3 mb-3">
    <div>
      <h1 class="h4 mb-1"><%= @idea.title %></h1>
      <p class="mb-0 text-gray-500"><%= @idea.description %></p>
    </div>
    <div class="text-right">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-900">ID: <%= @idea.id %></span>
      <br>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-200 mt-1"><%= @idea.created_at.strftime("%b %d, %Y %I:%M %p") %></span>
    </div>
  </div>
  <div class="md:flex gap-4">
    <div class="md:w-2/3">
      <div class="bg-white shadow-sm rounded">
        <div class="p-4">
          <div class="flex flex-wrap justify-between items-center mb-3 gap-3">
            <div class="flex gap-3 items-center">
              <span><strong>Ward:</strong> <%= @idea.ward %></span>
              <span><strong>Topic:</strong> <%= @idea.topic %></span>
            </div>
            <div>
              <%= community_idea_status_badge(@idea) %>
            </div>
          </div>
          <div class="grid grid-cols-3 text-center">
            <div>
              <h6 class="text-muted mb-1">Upvotes</h6>
              <p class="h5 mb-0"><%= @idea.upvotes %></p>
            </div>
            <div>
              <h6 class="text-muted mb-1">Downvotes</h6>
              <p class="h5 mb-0"><%= @idea.downvotes %></p>
            </div>
            <div>
              <h6 class="text-muted mb-1">Net score</h6>
              <p class="h5 mb-0"><%= @idea.net_score %></p>
            </div>
          </div>
          <div class="d-flex gap-2 mt-3">
            <%= button_to approve_admin_community_idea_path(@idea), method: :patch, class: "inline-block px-3 py-1 rounded bg-[var(--color-success)] text-white", form: { data: { turbo_confirm: "Approve this idea?" } } do %>
              <i class="bi bi-check-circle mr-1"></i> Approve
            <% end %>
            <%= button_to reject_admin_community_idea_path(@idea), method: :patch, class: "inline-block px-3 py-1 rounded border border-red-600 text-red-600", form: { data: { turbo_confirm: "Reject this idea?" } } do %>
              <i class="bi bi-x-circle mr-1"></i> Reject
            <% end %>
          </div>
        </div>
      </div>
      <div class="bg-white shadow-sm rounded mt-4" id="feedback">
        <div class="p-4">
          <h2 class="h6 mb-3">Admin feedback</h2>
          <%= form_with model: @idea, url: admin_community_idea_path(@idea), method: :patch do |form| %>
            <div class="mb-3">
              <%= form.label :admin_comment, "Share next steps or contextual notes" %>
              <%= form.text_area :admin_comment, class: "block w-full rounded-md border-2 border-gray-200 px-3 py-2 focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:ring-opacity-20", rows: 4 %>
            </div>
            <%= form.submit "Save feedback", class: "inline-block px-3 py-1 rounded bg-[var(--color-primary)] text-white" %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="md:w-1/3">
      <div class="bg-white shadow-sm rounded">
        <div class="p-4">
          <p class="text-muted mb-1"><strong>Description</strong></p>
          <p><%= @idea.description %></p>
          <hr>
          <p class="text-muted mb-1"><strong>Admin notes</strong></p>
          <p class="text-break"><%= @idea.admin_comment.presence || "No notes yet." %></p>
          <hr>
          <%= link_to "Back to overview", admin_community_ideas_path, class: "inline-block w-full py-2 rounded border border-gray-300 text-gray-700" %>
        </div>
      </div>
    </div>
  </div>
</div>
