<div class="max-w-7xl mx-auto py-4 px-4 sm:px-6">
  <div class="flex flex-col md:flex-row justify-between items-start gap-3 mb-3">
    <div>
      <h1 class="text-xl font-semibold mb-1"><%= @idea.title %></h1>
      <p class="text-sm text-gray-500 mb-0"><%= @idea.description %></p>
    </div>
    <div class="text-right">
      <span class="badge">ID: <%= @idea.id %></span>
      <div class="mt-1"><span class="badge badge-outline"><%= @idea.created_at.strftime("%b %d, %Y %I:%M %p") %></span></div>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
    <div class="xl:col-span-2">
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <div class="flex flex-wrap justify-between items-center mb-3 gap-3">
            <div class="flex gap-3 items-center">
              <span class="text-sm"><strong>Ward:</strong> <%= @idea.ward %></span>
              <span class="text-sm"><strong>Topic:</strong> <%= @idea.topic %></span>
            </div>
            <div>
              <%= community_idea_status_badge(@idea) %>
            </div>
          </div>
          <div class="grid grid-cols-3 text-center mb-3">
            <div>
              <h6 class="text-sm text-gray-500 mb-1">Upvotes</h6>
              <p class="text-lg font-bold mb-0"><%= @idea.upvotes %></p>
            </div>
            <div>
              <h6 class="text-sm text-gray-500 mb-1">Downvotes</h6>
              <p class="text-lg font-bold mb-0"><%= @idea.downvotes %></p>
            </div>
            <div>
              <h6 class="text-sm text-gray-500 mb-1">Net score</h6>
              <p class="text-lg font-bold mb-0"><%= @idea.net_score %></p>
            </div>
          </div>
          <div class="flex gap-2 mt-3">
            <%= button_to approve_admin_community_idea_path(@idea), method: :patch, class: "btn btn-success", form: { data: { turbo_confirm: "Approve this idea?" } } do %>
              Approve
            <% end %>
            <%= button_to reject_admin_community_idea_path(@idea), method: :patch, class: "btn btn-outline btn-error", form: { data: { turbo_confirm: "Reject this idea?" } } do %>
              Reject
            <% end %>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow mt-4" id="feedback">
        <div class="card-body">
          <h2 class="text-sm font-medium mb-3">Admin feedback</h2>
          <%= form_with model: @idea, url: admin_community_idea_path(@idea), method: :patch do |form| %>
            <div class="mb-4">
              <%= form.label :admin_comment, "Share next steps or contextual notes", class: 'block text-sm font-medium text-gray-700' %>
              <%= form.text_area :admin_comment, class: "textarea textarea-bordered w-full mt-1", rows: 4 %>
            </div>
            <%= render 'admin/shared/button', type: 'submit', variant: 'primary' do %>
              Save feedback
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <p class="text-sm text-gray-500 mb-1"><strong>Description</strong></p>
          <p class="text-sm mb-3"><%= @idea.description %></p>
          <hr class="my-3">
          <p class="text-sm text-gray-500 mb-1"><strong>Admin notes</strong></p>
          <p class="text-sm text-break mb-3"><%= @idea.admin_comment.presence || "No notes yet." %></p>
          <%= render 'admin/shared/button', href: admin_community_ideas_path, variant: 'outline', full: true do %>
            Back to overview
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
