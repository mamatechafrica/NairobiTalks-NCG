<div class="grid gap-8 lg:grid-cols-2">
  <section class="space-y-4" aria-labelledby="edit-broadcast-heading">
    <h1 id="edit-broadcast-heading" class="text-2xl font-bold">Edit Broadcast</h1>
    <div class="bg-white shadow rounded-lg border" aria-labelledby="broadcast-preview-heading">
      <div class="p-4">
        <p class="text-sm text-gray-500">Preview of the current broadcast card</p>
        <h2 id="broadcast-preview-heading" class="text-xl font-semibold mt-3"><%= @broadcast.title %></h2>
        <p class="text-gray-700 mt-2"><%= @broadcast.message %></p>
        <% if @broadcast.image.present? %>
          <div class="mt-3">
            <%= image_tag @broadcast.image.url, class: "w-full h-auto rounded", alt: @broadcast.title.presence || 'Broadcast image' %>
          </div>
        <% end %>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
          <div>
            <dt class="text-xs uppercase text-gray-500">Delivery Method</dt>
            <dd class="text-base font-medium text-gray-900"><%= @broadcast.delivery_method&.humanize || 'Not set' %></dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-gray-500">Ward</dt>
            <dd class="text-base font-medium text-gray-900"><%= @broadcast.ward&.name || 'All wards' %></dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-gray-500">Status</dt>
            <dd class="text-base font-medium text-gray-900"><%= @broadcast.status %></dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-gray-500">Created</dt>
            <dd class="text-base font-medium text-gray-900"><%= @broadcast.created_at.strftime('%b %-d, %Y %H:%M') %></dd>
          </div>
        </dl>
      </div>
    </div>
    <div class="flex gap-2">
      <%= link_to 'Back to list', admin_broadcasts_path, class: 'inline-flex items-center justify-center flex-1 px-4 py-2 rounded border border-gray-300 text-gray-700', aria: { label: 'Back to broadcast list' } %>
      <%= link_to 'Preview', admin_broadcast_path(@broadcast), class: 'inline-flex items-center justify-center flex-1 px-4 py-2 rounded border border-[var(--color-primary)] text-[var(--color-primary)]', aria: { label: 'Preview this broadcast' } %>
    </div>
  </section>
  <section aria-labelledby="edit-form-heading">
    <h2 id="edit-form-heading" class="sr-only">Edit Broadcast Form</h2>
    <%= form_with model: @broadcast, url: admin_broadcast_path(@broadcast), method: :patch, local: true, class: "space-y-6" do |form| %>
      <%= render 'form', f: form %>
    <% end %>
  </section>
</div>