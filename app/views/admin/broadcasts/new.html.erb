<div class="max-w-7xl mx-auto py-4 px-4 sm:px-6">
  <h1 class="mb-4 text-2xl font-semibold" id="new-broadcast-heading">New Broadcast</h1>
  <%= form_with model: @broadcast, url: admin_broadcasts_path, local: true, html: { 'aria-labelledby': 'new-broadcast-heading' } do |form| %>
    <fieldset>
      <legend class="sr-only">Broadcast Details</legend>
      <div class="mb-4">
        <%= form.label :title, 'Title', class: 'block text-sm font-medium text-gray-700', required: true %>
        <%= form.text_field :title, class: 'input input-bordered w-full mt-1', required: true, aria: { required: true } %>
      </div>
      <div class="mb-4">
        <%= form.label :message, 'Message', class: 'block text-sm font-medium text-gray-700', required: true %>
        <%= form.text_area :message, class: 'textarea textarea-bordered w-full mt-1', rows: 5, required: true, aria: { required: true } %>
      </div>
      <div class="mb-4">
        <%= form.label :ward_id, "Select Ward", class: 'block text-sm font-medium text-gray-700' %>
        <%= form.collection_select :ward_id, @wards, :id, :name, { include_blank: "Select a Ward" }, class: 'select select-bordered w-full mt-1', aria: { describedby: 'ward-desc' } %>
        <span id="ward-desc" class="text-sm text-gray-500">Choose a ward to target, or leave blank for all wards.</span>
      </div>
      <div class="mb-4">
        <%= form.label :delivery_type, 'Delivery Method', class: 'block text-sm font-medium text-gray-700', required: true %>
        <%= form.select :delivery_type, options_for_select(["In App", "Email", "SMS"]), {}, class: 'select select-bordered w-full mt-1', required: true, aria: { required: true } %>
      </div>
      <div class="mb-4">
        <%= form.label :image, 'Image (optional)', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.file_field :image, class: 'file-input file-input-bordered w-full mt-1', aria: { describedby: 'image-desc' } %>
        <span id="image-desc" class="text-sm text-gray-500">Upload an image to include with the broadcast (optional).</span>
      </div>
    </fieldset>
    <div class="mt-4 flex gap-2">
      <%= render 'admin/shared/button', type: 'submit', variant: 'primary', html_options: { aria: { label: 'Create new broadcast' } } do %>
        Create Broadcast
      <% end %>
      <%= render 'admin/shared/button', href: admin_broadcasts_path, variant: 'ghost', html_options: { aria: { label: 'Cancel and return to broadcast list' } } do %>
        Cancel
      <% end %>
    </div>
  <% end %>
</div>