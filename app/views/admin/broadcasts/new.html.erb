<div class="container py-4">
  <h1 class="mb-4">New Broadcast</h1>
  <%= form_with model: @broadcast, url: admin_broadcasts_path, local: true do |form| %>
    <div class="mb-3">
      <%= form.label :title, class: 'form-label' %>
      <%= form.text_field :title, class: 'form-control', required: true %>
    </div>
    <div class="mb-3">
      <%= form.label :message, class: 'form-label' %>
      <%= form.text_area :message, class: 'form-control', rows: 5, required: true %>
    </div>
    <div class="mb-3">
      <%= form.label :target_audience, class: 'form-label' %>
      <%= form.label :ward_id, "Select Ward", class: 'form-label' %>
      <%= form.collection_select :ward_id, @wards, :id, :name, { include_blank: "Select a Ward" }, class: 'form-select' %>
    </div>
    <div class="mb-3">
      <%= form.label :delivery_type, class: 'form-label' %>
      <%= form.select :delivery_type, options_for_select(["In App", "Email", "SMS"]), {}, class: 'form-select', required: true %>
    </div>
    <div class="mb-3">
      <%= form.label :image, class: 'form-label' %>
      <%= form.file_field :image, class: 'form-control' %>
    </div>
    <div class="mt-4">
      <%= form.submit 'Create Broadcast', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', admin_broadcasts_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>