<div class="container py-4">
  <h1 class="mb-4">Broadcast Preview</h1>
  <div class="bg-white shadow-sm rounded-lg">
    <div class="p-4">
      <h2 class="text-xl font-semibold"><%= @broadcast.title %></h2>
      <p class="text-gray-500"><%= @broadcast.message %></p>
      <p class="mt-3">
        <strong>Target Audience:</strong> <%= @broadcast.target_audience %>
      </p>
      <p>
        <strong>Created At:</strong> <%= @broadcast.created_at.strftime('%Y-%m-%d %H:%M') %>
      </p>
    </div>
  </div>
  <div class="mt-4">
    <%= link_to 'Back to Broadcasts', admin_broadcasts_path, class: 'inline-block px-4 py-2 rounded border border-gray-300 text-gray-700', aria: { label: 'Back to broadcasts list' } %>
    <%= link_to 'Edit Broadcast', edit_admin_broadcast_path(@broadcast), class: 'inline-block px-4 py-2 rounded bg-[var(--color-primary)] text-white', aria: { label: 'Edit this broadcast' } %>
  </div>
</div>