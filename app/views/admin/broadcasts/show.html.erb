<div class="max-w-7xl mx-auto py-4 px-4 sm:px-6">
  <h1 class="mb-4 text-2xl font-semibold">Broadcast Preview</h1>
  <div class="card bg-base-100 shadow-md">
    <div class="card-body">
      <h2 class="card-title text-lg font-semibold"><%= @broadcast.title %></h2>
      <p class="text-sm text-gray-600"><%= @broadcast.message %></p>
      <p class="mt-3 text-sm">
        <strong>Target Audience:</strong> <%= @broadcast.target_audience %>
      </p>
      <p class="text-sm">
        <strong>Created At:</strong> <%= @broadcast.created_at.strftime('%Y-%m-%d %H:%M') %>
      </p>
    </div>
  </div>
  <div class="mt-4 flex gap-2">
    <%= render 'admin/shared/button', href: admin_broadcasts_path, variant: 'ghost', html_options: { aria: { label: 'Back to broadcasts list' } } do %>
      Back to Broadcasts
    <% end %>
    <%= render 'admin/shared/button', href: edit_admin_broadcast_path(@broadcast), variant: 'primary', html_options: { aria: { label: 'Edit this broadcast' } } do %>
      Edit Broadcast
    <% end %>
  </div>
</div>