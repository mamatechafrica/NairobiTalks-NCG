<div class="max-w-7xl mx-auto py-4 px-4 sm:px-6">
  <div class="text-center mb-6">
    <h1 class="mb-2 text-2xl font-semibold">📢 Broadcast Center</h1>
    <p class="text-sm text-gray-500">Use this center to share public notices about idea submissions, participation sessions, and document reviews.</p>
  </div>

  <div class="mb-4">
    <%= render 'admin/shared/button', href: new_admin_broadcast_path, variant: 'primary', extra_classes: 'mb-3', html_options: { aria: { label: 'Create New Broadcast' } } do %>
      New Broadcast
    <% end %>
  </div>

  <div class="grid gap-4 grid-cols-1 lg:grid-cols-2 xl:grid-cols-3">
    <% @broadcasts.each do |broadcast| %>
      <div class="card bg-base-100 shadow h-full">
        <div class="card-body">
          <h2 class="text-lg font-semibold mb-3"><%= broadcast.title %></h2>
          <% if broadcast.image.present? %>
            <%= image_tag broadcast.image.url, class: 'w-full h-48 object-cover rounded mb-3', alt: broadcast.title %>
          <% end %>
          <p class="text-sm text-gray-500 mb-3"><%= broadcast.message.truncate(100) %></p>
          <div class="mb-2 text-sm text-gray-600">
            <div><strong>Audience:</strong> <%= broadcast.target_audience %></div>
            <div><strong>Delivery Type:</strong> <%= broadcast.delivery_type %></div>
            <div><strong>Status:</strong> <%= broadcast.status %></div>
            <div><strong>Created At:</strong> <%= broadcast.created_at.strftime('%Y-%m-%d %H:%M') %></div>
          </div>
        </div>
          <div class="card-actions p-4 flex items-center justify-between">
          <div class="flex gap-2">
            <%= render 'admin/shared/button', href: admin_broadcast_path(broadcast), variant: 'outline', size: 'sm', html_options: { aria: { label: "Preview Broadcast: #{broadcast.title}" } } do %>
              Preview
            <% end %>
            <%= render 'admin/shared/button', href: edit_admin_broadcast_path(broadcast), variant: 'outline', size: 'sm', html_options: { aria: { label: "Edit Broadcast: #{broadcast.title}" } } do %>
              Edit
            <% end %>
          </div>
          <%= render 'admin/shared/button', href: admin_broadcast_path(broadcast), variant: 'error', size: 'sm', html_options: { method: :delete, data: { confirm: 'Are you sure you want to archive this broadcast?' }, aria: { label: "Archive Broadcast: #{broadcast.title}" } } do %>
            Archive
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
