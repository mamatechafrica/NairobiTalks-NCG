<div class="admin-app-preview flex flex-col h-full">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="mb-1 text-2xl font-semibold">👁️ App Preview</h1>
      <p class="text-sm text-gray-500 mb-0">View the main application as users see it</p>
    </div>
    <div>
      <%= render 'admin/shared/button', href: root_path, variant: 'outline', html_options: { target: '_blank', 'aria-label' => 'Open app preview in new tab' } do %>
        Open in New Tab
      <% end %>
    </div>
  </div>

  <!-- Embedded App Content -->
  <div class="preview-container flex-1 relative mb-4">
    <iframe
      src="<%= root_path %>"
      class="w-full h-[70vh]"
      title="Nairobi Talks Application Preview"
      loading="lazy">
    </iframe>
  </div>

  <!-- Quick Navigation Links -->
  <div class="mt-3">
    <h6 class="text-sm text-gray-500 mb-2">Quick Navigation:</h6>
    <div class="flex flex-wrap gap-2">
      <%= render 'admin/shared/button', href: root_path, size: 'sm', variant: 'ghost', html_options: { target: '_blank', 'aria-label' => 'Go to Home' } do %>Home<% end %>
      <%= render 'admin/shared/button', href: community_ideas_path, size: 'sm', variant: 'ghost', html_options: { target: '_blank', 'aria-label' => 'Go to Community Ideas' } do %>Community Ideas<% end %>
      <%= render 'admin/shared/button', href: planning_documents_path, size: 'sm', variant: 'ghost', html_options: { target: '_blank', 'aria-label' => 'Go to Documents' } do %>Documents<% end %>
      <%= render 'admin/shared/button', href: new_submission_path, size: 'sm', variant: 'ghost', html_options: { target: '_blank', 'aria-label' => 'Go to Submit Idea' } do %>Submit Idea<% end %>
    </div>
  </div>
</div>
