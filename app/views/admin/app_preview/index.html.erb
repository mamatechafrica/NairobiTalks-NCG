<div class="admin-app-preview d-flex flex-column h-100">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">
        <i class="bi bi-eye me-2 text-primary"></i>
        App Preview
      </h2>
      <p class="text-muted mb-0">View the main application as users see it</p>
    </div>
    <div class="btn-group" role="group" aria-label="Preview options">
      <a href="<%= root_path %>" target="_blank" class="btn btn-outline-primary">
        <i class="bi bi-box-arrow-up-right me-1"></i>
        Open in New Tab
      </a>
    </div>
  </div>
  <!-- Embedded App Content -->
  <div class="preview-container flex-grow-1 position-relative">
    <iframe
      src="<%= root_path %>"
      class="w-100 h-100"
      title="Nairobi Talks Application Preview"
      loading="lazy">
    </iframe>
  </div>
  <!-- Quick Navigation Links -->
  <div class="mt-3">
    <h6 class="text-muted mb-2">Quick Navigation:</h6>
    <div class="d-flex flex-wrap gap-2">
      <a href="<%= root_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-house me-1"></i>Home
      </a>
      <a href="<%= community_ideas_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-lightbulb me-1"></i>Community Ideas
      </a>
      <a href="<%= ideas_explorer_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-search me-1"></i>Ideas Explorer
      </a>
      <a href="<%= new_submission_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-plus-circle me-1"></i>Submit Idea
      </a>
    </div>
  </div>
</div>