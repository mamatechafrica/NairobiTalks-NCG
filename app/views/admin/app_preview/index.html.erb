<div class="admin-app-preview flex flex-col h-full">
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="mb-1">
        <i class="bi bi-eye mr-2 text-primary" aria-hidden="true"></i>
        App Preview
      </h1>
      <p class="text-muted mb-0">View the main application as users see it</p>
    </div>
    <div class="flex gap-2" role="group" aria-label="Preview options">
      <a href="<%= root_path %>" target="_blank" class="inline-flex items-center px-3 py-1 rounded border border-[var(--color-primary)] text-[var(--color-primary)]" aria-label="Open app preview in new tab">
        <i class="bi bi-box-arrow-up-right mr-1" aria-hidden="true"></i>
        Open in New Tab
      </a>
    </div>
  </div>
  <!-- Embedded App Content -->
  <div class="preview-container grow relative">
    <iframe
      src="<%= root_path %>"
      class="w-full h-full"
      title="Nairobi Talks Application Preview"
      loading="lazy">
    </iframe>
  </div>
  <!-- Quick Navigation Links -->
  <div class="mt-3">
    <h6 class="text-muted mb-2">Quick Navigation:</h6>
    <div class="d-flex flex-wrap gap-2">
      <a href="<%= root_path %>" target="_blank" class="inline-flex items-center px-3 py-1 rounded border border-gray-300 text-gray-700 text-sm" aria-label="Go to Home">
        <i class="bi bi-house mr-1" aria-hidden="true"></i>Home
      </a>
      <a href="<%= community_ideas_path %>" target="_blank" class="inline-flex items-center px-3 py-1 rounded border border-gray-300 text-gray-700 text-sm" aria-label="Go to Community Ideas">
        <i class="bi bi-lightbulb mr-1" aria-hidden="true"></i>Community Ideas
      </a>
      <a href="<%= community_ideas_path %>" target="_blank" class="inline-flex items-center px-3 py-1 rounded border border-gray-300 text-gray-700 text-sm" aria-label="Go to Community Ideas">
        <i class="bi bi-search mr-1" aria-hidden="true"></i>Community Ideas
      </a>
      <a href="<%= new_submission_path %>" target="_blank" class="inline-flex items-center px-3 py-1 rounded border border-gray-300 text-gray-700 text-sm" aria-label="Go to Submit Idea">
        <i class="bi bi-plus-circle mr-1" aria-hidden="true"></i>Submit Idea
      </a>
    </div>
  </div>
</div>