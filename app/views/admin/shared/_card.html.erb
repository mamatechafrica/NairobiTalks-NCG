<%#
  Usage:
  <%= render 'admin/shared/card', title: 'My Title' do %>
    ...inner content...
  <% end %>

  Locals:
  - title: optional header text
  - footer: optional footer content (string or HTML-safe)
%>
<div class="card bg-base-100 shadow">
  <% if local_assigns.key?(:title) && title.present? %>
    <div class="card-body">
      <h3 class="text-lg font-semibold mb-2"><%= title %></h3>
      <%= capture(&block) if block_given? %>
    </div>
  <% else %>
    <div class="card-body">
      <%= capture(&block) if block_given? %>
    </div>
  <% end %>
  <% if local_assigns.key?(:footer) && footer.present? %>
    <div class="card-footer"><%= footer %></div>
  <% end %>
</div>
