<%= render 'admin/shared/admin_page_header', {
  page_title: 'Topic Details',
  page_icon: '📋',
  page_description: 'View and manage topic information'
} %>

<div class="bg-white shadow rounded-lg p-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <h4 class="text-xl font-semibold"><%= @topic.title %></h4>
      <p class="text-sm text-gray-500 mb-3"><%= @topic.created_at.strftime('%B %d, %Y') %></p>

      <div class="mb-6">
        <h6 class="font-medium mb-2">Description</h6>
        <p><%= @topic.description %></p>
      </div>

      <div>
        <h6 class="font-medium mb-3">Statistics</h6>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 items-stretch">
          <div class="card bg-base-100 text-center p-4">
            <h5 class="text-lg font-semibold"><%= @topic.posts&.count || 0 %></h5>
            <p class="text-sm text-gray-500 mt-1">Posts</p>
          </div>
          <div class="md:col-span-2 flex items-center">
            <%= render 'admin/shared/button', href: admin_topic_posts_path(@topic), variant: 'outline', full: true do %>
              View All Posts
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <aside>
      <div class="bg-base-100 rounded-lg p-4">
        <h6 class="mb-3 font-medium">Actions</h6>
        <div class="flex flex-col gap-2">
          <%= render 'admin/shared/button', href: edit_admin_topic_path(@topic), variant: 'outline' do %>
            Edit Topic
          <% end %>
          <%= render 'admin/shared/button', href: admin_forum_path, variant: 'outline' do %>
            View Forum
          <% end %>
          <%= button_to 'Delete Topic', admin_topic_path(@topic), method: :delete,
                class: 'btn btn-error',
                data: { confirm: "Are you sure you want to delete this topic? This will also delete all #{@topic.posts&.count || 0} posts." } %>
        </div>
      </div>
    </aside>
  </div>
</div>
