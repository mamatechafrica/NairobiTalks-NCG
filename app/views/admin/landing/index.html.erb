<div class="bg-light min-vh-100">
  <!-- Access Cards Section -->
  <section class="py-5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-5">
        <h1 class="text-4xl font-bold text-dark mb-3">Nairobi Talks</h1>
        <p class="lead text-gray-500">Choose your access level</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Public App Card -->
        <div class="h-full">
          <div class="bg-white shadow-sm rounded-lg h-full">
            <div class="p-5 text-center">
              <div class="bg-success rounded-full inline-flex items-center justify-center mb-4 w-20 h-20">
                <i class="bi bi-house text-white text-2xl" aria-hidden="true"></i>
              </div>
              <h2 class="font-bold mb-3">Community Platform</h2>
              <p class="text-gray-500 mb-4">
                Submit ideas, explore community proposals, and participate in shaping Nairobi's future. No registration required.
              </p>
              <div class="grid">
                <%= link_to "Enter Public App", community_ideas_path, class: "inline-block w-full py-3 rounded bg-[var(--color-success)] text-white font-semibold", aria: { label: "Enter Public App" } %>
              </div>
              <div class="mt-3">
                <small class="text-gray-500">
                  <i class="bi bi-unlock mr-1" aria-hidden="true"></i>
                  Public access • No login required
                </small>
              </div>
            </div>
          </div>
        </div>
            <!-- Admin Panel Card -->
            <div class="h-full">
              <div class="bg-white shadow-sm rounded-lg h-full">
                <div class="p-5 text-center">
                  <div class="bg-primary rounded-full inline-flex items-center justify-center mb-4 w-20 h-20">
                    <i class="bi bi-shield-lock text-white text-2xl" aria-hidden="true"></i>
                  </div>
                  <h2 class="font-bold mb-3">Admin Panel</h2>
                  <p class="text-gray-500 mb-4">
                    Manage submissions, moderate content, and oversee the platform. Administrative access required.
                  </p>
                  <div class="grid">
                    <%= link_to "Admin Login", new_user_session_path, class: "inline-block w-full py-3 rounded bg-[var(--color-primary)] text-white font-semibold", aria: { label: "Admin Login" } %>
                  </div>
                  <div class="mt-3">
                    <small class="text-gray-500">
                      <i class="bi bi-lock mr-1" aria-hidden="true"></i>
                      Admin access • Login required
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Footer -->
  <footer class="bg-white border-t py-4 mt-5">
    <div class="container text-center">
      <p class="text-muted mb-0">
        <small>© 2025 Nairobi Talks - Empowering Community Voices</small>
      </p>
    </div>
  </footer>
</div>