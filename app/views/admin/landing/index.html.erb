<div class="bg-gray-50 min-h-screen flex flex-col justify-between">
  <main class="flex-1 flex flex-col items-center justify-center py-12">
    <div class="w-full max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Nairobi Talks</h1>
        <p class="text-lg text-gray-500">Choose your access level</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Public App Card -->
        <div class="bg-white rounded-2xl shadow-lg flex flex-col items-center p-8 border border-gray-100">
          <div class="bg-green-500 rounded-full flex items-center justify-center mb-5" style="width: 80px; height: 80px;">
            <span class="text-white text-3xl">🏠</span>
          </div>
          <h2 class="text-2xl font-bold mb-2">Community Platform</h2>
          <p class="text-gray-500 mb-6 text-center">
            Submit ideas, explore community proposals, and participate in shaping Nairobi's future. No registration required.
          </p>
          <%= render 'admin/shared/button', label: 'Enter Public App', href: community_ideas_path, variant: 'success', size: 'lg', full: true, html_options: { aria: { label: 'Enter Public App' } } %>
          <div class="mt-4">
            <span class="inline-flex items-center text-xs text-gray-400">
              <span class="mr-1">🔓</span>
              Public access • No login required
            </span>
          </div>
        </div>
        <!-- Admin Panel Card -->
        <div class="bg-white rounded-2xl shadow-lg flex flex-col items-center p-8 border border-gray-100">
          <div class="bg-blue-600 rounded-full flex items-center justify-center mb-5" style="width: 80px; height: 80px;">
            <span class="text-white text-3xl">🔒</span>
          </div>
          <h2 class="text-2xl font-bold mb-2">Admin Panel</h2>
          <p class="text-gray-500 mb-6 text-center">
            Manage submissions, moderate content, and oversee the platform. Administrative access required.
          </p>
          <%= render 'admin/shared/button', label: 'Admin Login', href: new_user_session_path, variant: 'primary', size: 'lg', full: true, html_options: { aria: { label: 'Admin Login' } } %>
          <div class="mt-4">
            <span class="inline-flex items-center text-xs text-gray-400">
              <span class="mr-1">🔐</span>
              Admin access • Login required
            </span>
          </div>
        </div>
      </div>
    </div>
  </main>
  <footer class="bg-white border-t py-4">
    <div class="container mx-auto text-center">
      <p class="text-gray-400 text-sm mb-0">
        © 2025 Nairobi Talks - Empowering Community Voices
      </p>
    </div>
  </footer>
</div>