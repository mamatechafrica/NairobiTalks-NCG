<div class="grid grid-cols-1 lg:grid-cols-12 gap-3 mb-4">
  <div class="lg:col-span-8">
    <div class="card bg-base-100 shadow h-full">
      <div class="card-body">
        <div class="flex items-center justify-between">
          <div>
            <h5 class="mb-0">Submission statuses</h5>
            <p class="text-sm text-gray-500 mb-0">Quick glance at how reviews are progressing.</p>
          </div>
          <span class="badge">Total: <%= @submission_status_counts.values.sum %></span>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <% CitizenSubmission::STATUS_LABELS.each_key do |status_key| %>
            <% count = @submission_status_counts[status_key.to_s] || 0 %>
            <span class="badge badge-outline">
              <strong><%= CitizenSubmission::STATUS_LABELS[status_key] %></strong>
              <span class="ml-1">(<%= count %>)</span>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="lg:col-span-4">
    <div class="card bg-base-100 shadow h-full">
      <div class="card-body">
        <h5 class="mb-3">Flagged attention</h5>
        <% if @flagged_submissions_count.positive? %>
          <div class="p-3 rounded bg-yellow-50 border border-yellow-100 mb-3">
            <div class="flex items-start gap-3">
              <div class="text-yellow-500 text-xl">⚑</div>
              <div>
                <p class="mb-1 text-sm"><strong><%= pluralize(@flagged_submissions_count, "flagged submission") %></strong> needs review.</p>
                <p class="mb-0 text-xs text-gray-500">Prioritize those before approving.</p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="p-3 rounded bg-green-50 border border-green-100 mb-3">
            <div class="flex items-start gap-3">
              <div class="text-green-500 text-xl">✔️</div>
              <div>
                <p class="mb-1 text-sm"><strong>No flagged submissions.</strong></p>
                <p class="mb-0 text-xs text-gray-500">Keep monitoring as new ideas arrive.</p>
              </div>
            </div>
          </div>
        <% end %>
        <%= render 'admin/shared/button', href: admin_submissions_path, variant: 'ghost', full: true do %>
          Review submissions
        <% end %>
      </div>
    </div>
  </div>
</div>
