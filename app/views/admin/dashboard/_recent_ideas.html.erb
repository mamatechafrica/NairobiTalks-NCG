<div class="activity-section bg-white rounded p-4 shadow mb-4">
  <h5 class="text-emerald-700 mb-3 font-semibold">Recent Community Ideas</h5>
  <div class="activity-list">
    <% @recent_ideas.each do |idea| %>
      <div class="border rounded p-3 mb-2 bg-white">
        <div class="flex items-start gap-3">
          <div class="text-2xl">💡</div>
          <div class="flex-1">
            <strong class="block"><%= idea.title %></strong>
            <p class="mb-1 text-sm text-gray-500"><%= idea.description.truncate(100) %></p>
            <p class="mb-0 text-sm text-gray-500">
              ⏱️ <%= time_ago_in_words(idea.created_at) %> ago • 📍 <%= idea.ward %> • 👍 <%= idea.upvotes %> upvotes
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <% if @recent_ideas.empty? %>
    <div class="text-center py-6">
      <div class="text-4xl text-amber-400 mb-3">💡</div>
      <p class="text-sm text-gray-500 mt-2">No recent ideas yet</p>
    </div>
  <% end %>
</div>