<div class="activity-section bg-white rounded p-4 shadow mt-4">
  <h2 class="text-lg font-semibold mb-3">📄 Recent Documents</h2>
  <div class="activity-list">
    <% @recent_documents.each do |doc| %>
      <div class="activity-item border-b pb-3 mb-3 flex items-start gap-3">
        <div class="activity-icon flex-shrink-0 text-2xl">📄</div>
        <div class="activity-content flex-grow">
          <h4 class="text-sm font-medium mb-1"><%= doc.title %></h4>
          <p class="mb-1 text-sm text-gray-500"><%= doc.document_type %> • <%= doc.status.titleize %></p>
          <small class="text-sm text-gray-500">
            ⏱️ <%= time_ago_in_words(doc.created_at) %> ago
          </small>
        </div>
      </div>
    <% end %>
  </div>
  <% if @recent_documents.empty? %>
    <div class="text-center py-6">
      <div class="text-4xl text-emerald-500 mb-3">📄</div>
      <p class="text-sm text-gray-500 mt-2">No recent documents yet</p>
    </div>
  <% end %>
</div>