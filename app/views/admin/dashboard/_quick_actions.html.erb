<div class="bg-white rounded p-4 shadow-sm border">
  <h2 class="h4 mb-3 text-dark"><i class="bi bi-gear-fill text-primary mr-2"></i> System Status</h2>
  <div class="status-items">
    <div class="flex items-center mb-3">
      <i class="bi bi-check-circle-fill text-success mr-3 text-[1.2rem]"></i>
      <div>
        <div class="font-bold">Database</div>
        <small class="text-gray-500">All systems operational</small>
      </div>
    </div>
    <div class="flex items-center mb-3">
      <i class="bi bi-check-circle-fill text-success mr-3 text-[1.2rem]"></i>
      <div>
        <div class="font-bold">File Storage</div>
        <small class="text-gray-500">Active and healthy</small>
      </div>
    </div>
    <div class="flex items-center">
      <i class="bi bi-check-circle-fill text-success mr-3 text-[1.2rem]"></i>
      <div>
        <div class="font-bold">API Services</div>
        <small class="text-gray-500">Running smoothly</small>
      </div>
    </div>
  </div>
</div>
<!-- Quick Actions Card -->
<div class="bg-white rounded p-4 shadow-sm border mt-4">
  <h2 class="h4 mb-3 text-dark"><i class="bi bi-lightning-charge-fill text-warning mr-2"></i> Quick Actions</h2>
  <div class="grid gap-2">
    <%= link_to admin_analytics_path, class: "inline-flex items-center justify-center px-4 py-2 rounded bg-[var(--color-primary)] text-white font-semibold" do %>
      <i class="bi bi-graph-up mr-2"></i> View Analytics
    <% end %>
    <%= link_to data_export_ideas_path(format: :csv), class: "inline-flex items-center justify-center px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" do %>
      <i class="bi bi-download mr-2"></i> Export Data
    <% end %>
  </div>
</div>