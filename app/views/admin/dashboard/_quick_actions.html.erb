<div class="bg-white rounded p-4 shadow-sm border">
  <h2 class="h4 mb-3 text-dark"><i class="bi bi-gear-fill text-primary me-2"></i> System Status</h2>
  <div class="status-items">
    <div class="d-flex align-items-center mb-3">
      <i class="bi bi-check-circle-fill text-success me-3" style="font-size: 1.2rem;"></i>
      <div>
        <div class="fw-bold">Database</div>
        <small class="text-muted">All systems operational</small>
      </div>
    </div>
    <div class="d-flex align-items-center mb-3">
      <i class="bi bi-check-circle-fill text-success me-3" style="font-size: 1.2rem;"></i>
      <div>
        <div class="fw-bold">File Storage</div>
        <small class="text-muted">Active and healthy</small>
      </div>
    </div>
    <div class="d-flex align-items-center">
      <i class="bi bi-check-circle-fill text-success me-3" style="font-size: 1.2rem;"></i>
      <div>
        <div class="fw-bold">API Services</div>
        <small class="text-muted">Running smoothly</small>
      </div>
    </div>
  </div>
</div>
<!-- Quick Actions Card -->
<div class="bg-white rounded p-4 shadow-sm border mt-4">
  <h2 class="h4 mb-3 text-dark"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Quick Actions</h2>
  <div class="d-grid gap-2">
    <%= link_to admin_analytics_path, class: "btn btn-primary" do %>
      <i class="bi bi-graph-up me-2"></i> View Analytics
    <% end %>
    <%= link_to data_export_ideas_path(format: :csv), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-download me-2"></i> Export Data
    <% end %>
  </div>
</div>