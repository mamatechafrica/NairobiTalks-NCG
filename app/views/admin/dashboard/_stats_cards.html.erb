<div class="dashboard-stats grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 mb-4">
  <div class="bg-white shadow rounded-lg p-4 text-center">
    <div class="mb-3 text-3xl">💡</div>
    <h2 class="mb-1 text-2xl font-bold text-gray-900" aria-label="Total Community Ideas"><%= @total_ideas %></h2>
    <p class="mb-0 text-sm text-gray-500">Community Ideas</p>
  </div>

  <div class="bg-white shadow rounded-lg p-4 text-center">
    <div class="mb-3 text-3xl">📄</div>
    <h2 class="mb-1 text-2xl font-bold text-gray-900" aria-label="Total Planning Documents"><%= @total_documents %></h2>
    <p class="mb-0 text-sm text-gray-500">Planning Documents</p>
  </div>

  <div class="bg-white shadow rounded-lg p-4 text-center">
    <div class="mb-3 text-3xl">📈</div>
    <h2 class="mb-1 text-2xl font-bold text-gray-900" aria-label="Total Updates"><%= @total_votes %></h2>
    <p class="mb-0 text-sm text-gray-500">Total Updates</p>
  </div>

  <div class="bg-white shadow rounded-lg p-4 text-center">
    <div class="mb-3 text-3xl">👥</div>
    <h2 class="mb-1 text-2xl font-bold text-gray-900" aria-label="Total Registered Users"><%= User.count %></h2>
    <p class="mb-0 text-sm text-gray-500">Registered Users</p>
  </div>
</div>