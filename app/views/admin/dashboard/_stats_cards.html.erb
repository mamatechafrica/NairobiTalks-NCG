<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
  <div>
    <div class="bg-white shadow-sm rounded-lg h-full">
      <div class="p-4 text-center">
        <div class="stat-icon mb-3">
          <i class="bi bi-lightbulb-fill text-warning text-[2.5rem]" aria-hidden="true"></i>
        </div>
        <h2 class="mb-1 text-dark font-bold" aria-label="Total Community Ideas"><%= @total_ideas %></h2>
        <p class="mb-0 text-gray-500">Community Ideas</p>
      </div>
    </div>
  </div>
  <div>
    <div class="bg-white shadow-sm rounded-lg h-full">
      <div class="p-4 text-center">
        <div class="stat-icon mb-3">
          <i class="bi bi-file-earmark-text-fill text-primary text-[2.5rem]" aria-hidden="true"></i>
        </div>
        <h2 class="mb-1 text-dark font-bold" aria-label="Total Planning Documents"><%= @total_documents %></h2>
        <p class="mb-0 text-gray-500">Planning Documents</p>
      </div>
    </div>
  </div>
  <div>
    <div class="bg-white shadow-sm rounded-lg h-full">
      <div class="p-4 text-center">
        <div class="stat-icon mb-3">
          <i class="bi bi-graph-up-arrow text-success text-[2.5rem]" aria-hidden="true"></i>
        </div>
        <h2 class="mb-1 text-dark font-bold" aria-label="Total Updates"><%= @total_votes %></h2>
        <p class="mb-0 text-gray-500">Total Updates</p>
      </div>
    </div>
  </div>
  <div>
    <div class="bg-white shadow-sm rounded-lg h-full">
      <div class="p-4 text-center">
        <div class="stat-icon mb-3">
          <i class="bi bi-people-fill text-info text-[2.5rem]" aria-hidden="true"></i>
        </div>
        <h2 class="mb-1 text-dark font-bold" aria-label="Total Registered Users"><%= User.count %></h2>
        <p class="mb-0 text-gray-500">Registered Users</p>
      </div>
    </div>
  </div>
</div>